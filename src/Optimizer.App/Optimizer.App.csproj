<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>PCOptimizer</AssemblyName>
    <RootNamespace>Optimizer.App</RootNamespace>
    <!-- Program.Main secures the data folder and native library loading before WPF starts. -->
    <StartupObject>Optimizer.App.Program</StartupObject>
    <!-- DOTNET_STARTUP_HOOKS from the user's environment would run code in the elevated app before Main. -->
    <StartupHookSupport>false</StartupHookSupport>
    <Version>0.5.2</Version>
    <Product>PCOptimizer</Product>
    <Authors>Joshua Zürn</Authors>
    <Company>Joshua Zürn</Company>
    <Copyright>Copyright (c) 2026 Joshua Zürn</Copyright>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SatelliteResourceLanguages>en;de</SatelliteResourceLanguages>
    <!-- Release: always elevated. Debug: asInvoker so the scanner can be run without UAC during development. -->
    <ApplicationManifest Condition="'$(Configuration)' == 'Release'">app.manifest</ApplicationManifest>
    <ApplicationManifest Condition="'$(Configuration)' != 'Release'">app.debug.manifest</ApplicationManifest>
    <!-- Exe, taskbar and Alt+Tab icon (16 to 256 px; sources in docs/brand) -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\icon-16.png;Assets\icon-24.png;Assets\icon-32.png" />
  </ItemGroup>

  <!-- License texts shown under Settings > About (MIT, BSD, MPL and Apache require them to ship with the exe). -->
  <ItemGroup>
    <EmbeddedResource Include="Licenses\*.txt;Licenses\licenses.json" LogicalName="Licenses.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="Licenses.PCOptimizer.txt" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Optimizer.Core\Optimizer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Markdig" Version="1.4.0" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

</Project>
