<UserControl x:Class="Optimizer.App.Views.AdvisorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:Optimizer.App.Services"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <!-- The list scrolls on its own and builds only the cards in view. -->
    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <DockPanel>
                <ui:ToggleSwitch DockPanel.Dock="Right" Content="{l:Tr Dash_ShowAll}" IsChecked="{Binding ShowPassed}" VerticalAlignment="Top" />
                <StackPanel>
                    <ui:TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr Advisor_Title}" />
                    <ui:TextBlock Style="{StaticResource PageIntro}" Text="{l:Tr Advisor_Hint}" />
                </StackPanel>
            </DockPanel>
            <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Empty_List}" Visibility="{Binding AdvisorEmpty, Converter={StaticResource BoolToVisibility}}" />
            <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding AdvisorPassedText}" Margin="0,0,0,8"
                          Visibility="{Binding AdvisorPassedText, Converter={StaticResource NullToVisibility}}" />
        </StackPanel>
        <ItemsControl Grid.Row="1" Style="{StaticResource VirtualCardList}" ItemsSource="{Binding AdvisorItems}" ItemTemplate="{StaticResource FindingRow}" />
    </Grid>
</UserControl>
