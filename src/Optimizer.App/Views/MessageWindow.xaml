<ui:FluentWindow x:Class="Optimizer.App.Views.MessageWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Width="560" MinHeight="0" SizeToContent="Height" ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <!-- Laid out like a Windows 11 content dialog: title and text, then a footer band with the buttons side by side. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="" ShowMinimize="False" ShowMaximize="False" ShowHelp="False" />
        <StackPanel Grid.Row="1" Margin="24,0,24,24">
            <ui:TextBlock x:Name="TitleText" FontTypography="Subtitle" TextWrapping="Wrap" />
            <ui:TextBlock x:Name="BodyText" FontTypography="Body" TextWrapping="Wrap" Margin="0,12,0,0"
                          Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        </StackPanel>
        <Border Grid.Row="2" Padding="24" BorderThickness="0,1,0,0"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid x:Name="Buttons" />
        </Border>
    </Grid>
</ui:FluentWindow>
