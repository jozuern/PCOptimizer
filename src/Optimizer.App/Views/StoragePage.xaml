<UserControl x:Class="Optimizer.App.Views.StoragePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:Optimizer.App.Services"
             xmlns:v="clr-namespace:Optimizer.App.Views"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <UserControl.Resources>
        <!-- A file in Largest files or Duplicates: path and last change or group note, size on the right, a tick where it may be recycled -->
        <DataTemplate x:Key="FileRow">
            <DockPanel Margin="0,4">
                <ui:TextBlock DockPanel.Dock="Right" FontTypography="Body" Text="{Binding SizeText}" Margin="16,0,0,0" />
                <CheckBox IsChecked="{Binding Selected}" IsEnabled="{Binding CanRecycle}" AutomationProperties.Name="{Binding Path}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Mono}" Text="{Binding Path}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Meta}" />
                    </StackPanel>
                </CheckBox>
            </DockPanel>
        </DataTemplate>
    </UserControl.Resources>
    <!-- Drive picker and the result stay in place; each tab scrolls below them. Nothing is read before Analyze. -->
    <Grid Style="{StaticResource PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <ui:TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr Storage_PageTitle}" />
            <ui:TextBlock Style="{StaticResource PageIntro}" Text="{l:Tr Storage_PageHint}" />
            <ui:Card Padding="{StaticResource CardPadding}" Margin="0,0,0,8">
                <StackPanel>
                    <WrapPanel>
                        <!-- Each drive with its used share (two borders, as on System info) and free space -->
                        <ComboBox ItemsSource="{Binding Storage.Drives}" SelectedItem="{Binding Storage.SelectedDrive}" MinWidth="280" Margin="0,0,8,0"
                                  AutomationProperties.Name="{l:Tr Storage_Drive}" IsEnabled="{Binding Storage.IsBusy, Converter={StaticResource InverseBool}}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Root}" />
                                            <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding SpaceText}"
                                                          Margin="12,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Border Width="200" Height="4" CornerRadius="2" HorizontalAlignment="Left" Margin="0,4,0,0" Background="{DynamicResource ControlStrongFillColorDisabledBrush}">
                                            <Border Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="2" RenderTransformOrigin="0,0.5">
                                                <Border.RenderTransform>
                                                    <ScaleTransform ScaleX="{Binding UsedShare}" />
                                                </Border.RenderTransform>
                                            </Border>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ui:Button Appearance="Primary" Content="{l:Tr Storage_Analyze}" Icon="{ui:SymbolIcon Search20}" Command="{Binding Storage.AnalyzeCommand}"
                                   IsEnabled="{Binding Storage.IsBusy, Converter={StaticResource InverseBool}}" VerticalAlignment="Center" />
                    </WrapPanel>
                    <!-- After an analysis: what it read, and Close result to drop it -->
                    <DockPanel Margin="0,12,0,0" Visibility="{Binding Storage.HasResult, Converter={StaticResource BoolToVisibility}}">
                        <ui:Button DockPanel.Dock="Right" Content="{l:Tr Storage_CloseResult}" Icon="{ui:SymbolIcon Dismiss20}" Command="{Binding Storage.CloseResultCommand}"
                                   IsEnabled="{Binding Storage.IsBusy, Converter={StaticResource InverseBool}}" Margin="16,0,0,0" VerticalAlignment="Center" />
                        <ui:TextBlock FontTypography="Body" Text="{Binding Storage.ResultText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                </StackPanel>
            </ui:Card>
        </StackPanel>
        <TabControl Grid.Row="1" ItemContainerStyle="{StaticResource SelectorTab}" SelectedIndex="{Binding Storage.Tab}">
            <TabItem Header="{l:Tr Storage_TabFolders}">
                <ScrollViewer Style="{StaticResource EdgeTabScroll}">
                    <StackPanel Style="{StaticResource EdgeContent}">
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Storage_NoResult}" Visibility="{Binding Storage.NoResult, Converter={StaticResource BoolToVisibility}}" />
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Storage_TabNotReady}" Visibility="{Binding Storage.HasResult, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{l:Tr Storage_TabTypes}">
                <ScrollViewer Style="{StaticResource EdgeTabScroll}">
                    <StackPanel Style="{StaticResource EdgeContent}">
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Storage_NoResult}" Visibility="{Binding Storage.NoResult, Converter={StaticResource BoolToVisibility}}" />
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Storage_TabNotReady}" Visibility="{Binding Storage.HasResult, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{l:Tr Storage_TabLargest}">
                <ScrollViewer Style="{StaticResource EdgeTabScroll}">
                    <StackPanel Style="{StaticResource EdgeContent}">
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Storage_NoResult}" Visibility="{Binding Storage.NoResult, Converter={StaticResource BoolToVisibility}}" />
                        <StackPanel Visibility="{Binding Storage.LargestFiles.Count, Converter={StaticResource CountToVisibility}}">
                            <ui:Button Content="{l:Tr Storage_Recycle}" Icon="{ui:SymbolIcon Delete20}" Command="{Binding Storage.RecycleSelectedCommand}"
                                       IsEnabled="{Binding Storage.HasSelection}" Margin="0,0,0,8" />
                            <ui:Card Padding="{StaticResource CardPadding}">
                                <v:ItemList ItemsSource="{Binding Storage.LargestFiles}" ItemTemplate="{StaticResource FileRow}" />
                            </ui:Card>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{l:Tr Storage_TabDuplicates}">
                <ScrollViewer Style="{StaticResource EdgeTabScroll}">
                    <StackPanel Style="{StaticResource EdgeContent}">
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Storage_NoResult}" Visibility="{Binding Storage.NoResult, Converter={StaticResource BoolToVisibility}}" />
                        <!-- Nothing is hashed before Find duplicates -->
                        <ui:Card Padding="{StaticResource CardPadding}" Margin="0,0,0,8" Visibility="{Binding Storage.HasResult, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel>
                                <ui:Button DockPanel.Dock="Right" Content="{l:Tr Storage_FindDuplicates}" Icon="{ui:SymbolIcon DocumentCopy20}" Command="{Binding Storage.FindDuplicatesCommand}"
                                           IsEnabled="{Binding Storage.CanFindDuplicates}" Margin="16,0,0,0" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Storage_DuplicatesHint}" />
                                    <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Storage.DuplicatesText}" Margin="0,4,0,0"
                                                  Visibility="{Binding Storage.DuplicatesText, Converter={StaticResource NullToVisibility}}" />
                                    <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Storage_NoDuplicates}" Margin="0,4,0,0"
                                                  Visibility="{Binding Storage.NoDuplicates, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </DockPanel>
                        </ui:Card>
                        <StackPanel Visibility="{Binding Storage.Duplicates.Count, Converter={StaticResource CountToVisibility}}">
                            <ui:Button Content="{l:Tr Storage_Recycle}" Icon="{ui:SymbolIcon Delete20}" Command="{Binding Storage.RecycleSelectedCommand}"
                                       IsEnabled="{Binding Storage.HasSelection}" Margin="0,0,0,8" />
                            <ui:Card Padding="{StaticResource CardPadding}">
                                <v:ItemList ItemsSource="{Binding Storage.Duplicates}" ItemTemplate="{StaticResource FileRow}" />
                            </ui:Card>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
