<ui:FluentWindow x:Class="Optimizer.App.Views.ConfirmWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:l="clr-namespace:Optimizer.App.Services"
                 Width="760" MinHeight="0" SizeToContent="Height" MaxHeight="820" ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- Content layer above the footer's base color, so the band also stands out in dark mode -->
        <Border Grid.Row="0" Grid.RowSpan="2" Background="{DynamicResource LayerFillColorAltBrush}" />
        <ui:TitleBar Grid.Row="0" Title="" ShowMinimize="False" ShowMaximize="False" ShowHelp="False" />
        <DockPanel Grid.Row="1" Margin="24,0,24,24">
            <StackPanel DockPanel.Dock="Top">
                <ui:TextBlock x:Name="TitleText" FontTypography="Subtitle" TextWrapping="Wrap" />
                <ui:TextBlock x:Name="SummaryText" FontTypography="Body" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                <!-- Facts about the change as tags, as on the tweak rows -->
                <ItemsControl x:Name="BadgeList" Margin="0,8,0,0" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="4" Padding="6,1,6,2" Margin="0,2,4,2" BorderThickness="1"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                <TextBlock Text="{Binding}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- What stops the change first (error), then the notes about it (caution) -->
                <ItemsControl x:Name="BlockList" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:InfoBar Title="" Message="{Binding}" Severity="Error" IsOpen="True" IsClosable="False" Margin="0,0,0,4" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ui:InfoBar x:Name="NothingToDo" Title="" Message="{l:Tr Confirm_NothingToChange}" Severity="Informational" IsOpen="False" IsClosable="False" Margin="0,0,0,4" />
                <ItemsControl x:Name="WarningList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:InfoBar Title="" Message="{Binding}" Severity="Warning" IsOpen="True" IsClosable="False" Margin="0,0,0,4" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <CheckBox x:Name="AntiCheatAck" Content="{l:Tr Confirm_AntiCheatAck}" Margin="0,8,0,0" Visibility="Collapsed"
                          Checked="AntiCheat_Changed" Unchecked="AntiCheat_Changed" />

                <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Confirm_Changes}" Margin="0,24,0,8" />
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="180" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{l:Tr Confirm_Target}" />
                    <ui:TextBlock Grid.Column="1" FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{l:Tr Confirm_Now}" />
                    <ui:TextBlock x:Name="NewHeader" Grid.Column="2" FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Grid>
                <Separator />
            </StackPanel>

            <ScrollViewer x:Name="ChangeScroll" VerticalScrollBarVisibility="Auto" MaxHeight="360">
                <ItemsControl x:Name="ChangeList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="180" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Target}" Style="{StaticResource Mono}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,16,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding Before}" Style="{StaticResource Mono}" Margin="0,0,12,0" />
                                    <TextBlock x:Name="After" Grid.Column="2" Text="{Binding After}" Style="{StaticResource Mono}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </Grid>
                            </Border>
                            <!-- A value that already is what the change writes ("Already set"): not bold, so the real changes stand out -->
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Unchanged}" Value="True">
                                    <Setter TargetName="After" Property="FontWeight" Value="Normal" />
                                    <Setter TargetName="After" Property="FontFamily" Value="{DynamicResource ContentControlThemeFontFamily}" />
                                    <Setter TargetName="After" Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
        <!-- Footer band with the buttons, as in a Windows 11 content dialog -->
        <Border Grid.Row="2" Padding="24" BorderThickness="0,1,0,0"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <DockPanel LastChildFill="False">
                <!-- Windows 11 content dialog order: the primary button first, Cancel last (on the right) -->
                <ui:Button DockPanel.Dock="Right" Content="{l:Tr Confirm_Cancel}" MinWidth="100" IsCancel="True" />
                <ui:Button x:Name="ApplyButton" DockPanel.Dock="Right" Appearance="Primary" MinWidth="120" Margin="0,0,8,0" Click="Apply_Click" IsDefault="True" />
                <ui:TextBlock x:Name="FooterText" DockPanel.Dock="Left" FontTypography="Caption" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="380" />
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
