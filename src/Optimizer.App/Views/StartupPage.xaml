<UserControl x:Class="Optimizer.App.Views.StartupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:s="clr-namespace:Optimizer.App.Services"
             xmlns:l="clr-namespace:Optimizer.App.Services"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid Style="{StaticResource PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <ui:Button DockPanel.Dock="Right" Content="{l:Tr Common_Refresh}" Icon="{ui:SymbolIcon ArrowClockwise20}" Command="{Binding Startup.ReloadCommand}" ToolTip="F5" VerticalAlignment="Top" />
            <StackPanel>
                <ui:TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr Startup_Title}" />
                <ui:TextBlock Style="{StaticResource PageIntro}" Text="{l:Tr Startup_Hint}" />
            </StackPanel>
        </DockPanel>

        <ui:Card Grid.Row="1" Padding="16,12" Margin="0,0,0,8">
            <StackPanel>
                <WrapPanel>
                    <ui:TextBox PlaceholderText="{l:Tr Startup_Search}" Icon="{ui:SymbolIcon Search20}" Text="{Binding Startup.Search, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                MinWidth="240" Margin="0,4,16,4" ClearButtonEnabled="True" />
                    <ComboBox ItemsSource="{Binding Startup.Kinds}" SelectedItem="{Binding Startup.SelectedKind}" DisplayMemberPath="Text" MinWidth="220" Margin="0,4,16,4" AutomationProperties.Name="{l:Tr Startup_KindFilter}" />
                    <ui:ToggleSwitch Content="{l:Tr Startup_HideMicrosoft}" IsChecked="{Binding Startup.HideMicrosoft}" Margin="0,4,16,4" />
                    <ui:ToggleSwitch Content="{l:Tr Startup_OnlyAttention}" IsChecked="{Binding Startup.OnlyAttention}" Margin="0,4,16,4" />
                    <ui:ToggleSwitch Content="{l:Tr Startup_OnlyNew}" IsChecked="{Binding Startup.OnlyNew}" Margin="0,4,16,4"
                                     Visibility="{Binding Startup.HasComparison, Converter={StaticResource BoolToVisibility}}" />
                </WrapPanel>
                <!-- Actions on their own row, below the filters -->
                <WrapPanel>
                    <!-- With a key: the check (its tooltip says what is sent). Without one: the way to Settings, not a button that fails. -->
                    <ui:Button Content="{l:Tr Vt_Check}" Icon="{ui:SymbolIcon ShieldCheckmark24}" Command="{Binding Startup.CheckVirusTotalCommand}"
                               IsEnabled="{Binding Startup.IsCheckingVirusTotal, Converter={StaticResource InverseBool}}" Margin="0,4,8,4" ToolTip="{l:Tr Vt_Hint}"
                               Visibility="{Binding VirusTotalConfigured, Converter={StaticResource BoolToVisibility}}" />
                    <ui:Button Content="{l:Tr Common_Stop}" Command="{Binding Startup.StopVirusTotalCommand}"
                               Visibility="{Binding Startup.IsCheckingVirusTotal, Converter={StaticResource BoolToVisibility}}" Margin="0,4,8,4" />
                    <ui:Button Content="{l:Tr Startup_SaveSnapshot}" Icon="{ui:SymbolIcon Save20}" Command="{Binding Startup.SaveSnapshotCommand}" Margin="0,4,8,4" Appearance="Transparent" />
                    <ui:Button Content="{l:Tr Startup_CompareSnapshot}" Icon="{ui:SymbolIcon BranchCompare20}" Command="{Binding Startup.CompareSnapshotCommand}" Margin="0,4,16,4" Appearance="Transparent" />
                    <ui:HyperlinkButton Content="{l:Tr Vt_AddKey}" Command="{Binding OpenSettingsCommand}" Padding="0" Margin="0,4,8,4" VerticalAlignment="Center"
                                        ToolTip="{l:Tr Vt_Hint}" Visibility="{Binding VirusTotalConfigured, Converter={StaticResource InverseBoolToVisibility}}" />
                </WrapPanel>
                <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Startup.SnapshotText}" Margin="0,8,0,0" TextWrapping="Wrap"
                              Visibility="{Binding Startup.SnapshotText, Converter={StaticResource NullToVisibility}}" />
                <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Startup.SummaryText}" Margin="0,8,0,0" />
                <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Startup.VirusTotalStatus}" Margin="0,4,0,0"
                              Visibility="{Binding Startup.VirusTotalStatus, Converter={StaticResource NullToVisibility}}" />
            </StackPanel>
        </ui:Card>

        <ui:ProgressRing Grid.Row="2" IsIndeterminate="True" Width="24" Height="24" HorizontalAlignment="Left" Margin="0,0,0,8"
                         Visibility="{Binding Startup.IsLoading, Converter={StaticResource BoolToVisibility}}" />

        <ItemsControl Grid.Row="3" ItemsSource="{Binding Startup.Rows}" Style="{StaticResource VirtualCardList}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ui:Card Padding="{StaticResource CardPadding}" Margin="{StaticResource CardRowMargin}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0">
                                <ui:ToggleSwitch AutomationProperties.Name="{Binding Name}" IsChecked="{Binding SwitchState, Mode=TwoWay}"
                                                 OnContent="{l:Tr Startup_Enabled}" OffContent="{l:Tr Startup_Disabled}"
                                                 Visibility="{Binding CanToggle, Converter={StaticResource BoolToVisibility}}" >
                                    <ui:ToggleSwitch.IsEnabled>
                                        <MultiBinding Converter="{StaticResource AllTrue}">
                                            <Binding Path="CanToggle" />
                                            <Binding Path="CanChange" Source="{x:Static s:ChangeGate.Instance}" />
                                        </MultiBinding>
                                    </ui:ToggleSwitch.IsEnabled>
                                </ui:ToggleSwitch>
                                <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding ReadOnlyNote}" MaxWidth="160" TextWrapping="Wrap"
                                              Visibility="{Binding ReadOnlyNote, Converter={StaticResource NullToVisibility}}" />
                            </StackPanel>
                            <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Warning20" Filled="True" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Top"
                                           Foreground="{DynamicResource SystemFillColorCautionBrush}" Visibility="{Binding NeedsAttention, Converter={StaticResource BoolToHidden}}" />
                            <StackPanel>
                                <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Name}" TextWrapping="Wrap" />
                                <!-- Why it needs attention, in the caution color: not signed, runs a script, unusual place -->
                                <ItemsControl ItemsSource="{Binding AttentionTags}" Focusable="False" Margin="0,2,0,0"
                                              Visibility="{Binding AttentionTags.Count, Converter={StaticResource CountToVisibility}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource TagBorder}" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}">
                                                <TextBlock Text="{Binding}" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="{l:Tr Startup_New}" Margin="0,2,0,0"
                                              Visibility="{Binding IsNew, Converter={StaticResource BoolToVisibility}}" />
                                <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0">
                                    <Run Text="{Binding MetaText, Mode=OneWay}" />
                                </ui:TextBlock>
                                <TextBlock Style="{StaticResource Mono}" Text="{Binding Command}" Margin="0,4,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Command}" Visibility="{Binding DataContext.ShowTechnical, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
                                <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="{Binding ScriptHostNote}" TextWrapping="Wrap"
                                              Margin="0,4,0,0" Visibility="{Binding ScriptHostNote, Converter={StaticResource NullToVisibility}}" />
                                <!-- Where it is registered, with the two links on the same line -->
                                <WrapPanel Margin="0,4,0,0">
                                    <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Location}" TextWrapping="Wrap"
                                                  VerticalAlignment="Center" Margin="0,0,16,0" Visibility="{Binding DataContext.ShowTechnical, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
                                    <ui:HyperlinkButton Content="{l:Tr Startup_ShowFile}" Padding="0" Margin="0,0,16,0"
                                                        Visibility="{Binding Entry.ImagePath, Converter={StaticResource NullToVisibility}}"
                                                        Command="{Binding DataContext.Startup.ShowFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    <ui:HyperlinkButton Content="{l:Tr Startup_CopyLocation}" Padding="0"
                                                        Command="{Binding DataContext.Startup.CopyLocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                </WrapPanel>
                                <ui:HyperlinkButton Content="{Binding VirusTotalText}" Padding="0" Margin="0,4,0,0"
                                                    Visibility="{Binding VirusTotalText, Converter={StaticResource NullToVisibility}}"
                                                    Command="{Binding DataContext.Startup.OpenReportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding VirusTotalUrl}" />
                            </StackPanel>
                        </DockPanel>
                    </ui:Card>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
