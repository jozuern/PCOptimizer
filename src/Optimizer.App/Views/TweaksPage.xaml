<UserControl x:Class="Optimizer.App.Views.TweaksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:Optimizer.App.Services"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource PagePadding}">
            <ui:TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr Tweaks_Title}" />
            <ui:TextBlock Style="{StaticResource PageIntro}" Text="{l:Tr Tweaks_Hint}" />

            <ui:InfoBar Title="" Message="{l:Tr Banner_AdminToApply}" Severity="Warning" IsClosable="False"
                        IsOpen="{Binding IsElevated, Converter={StaticResource InverseBool}}" Margin="0,0,0,8" />

            <!-- Filters and Apply recommended -->
            <ui:Card Padding="16,12" Margin="0,0,0,16">
                <DockPanel>
                    <ui:Button DockPanel.Dock="Right" Appearance="Primary" Content="{Binding RecommendedButtonText}" Command="{Binding ApplyRecommendedCommand}"
                               IsEnabled="{Binding HasRecommendations}" />
                    <WrapPanel Orientation="Horizontal">
                        <ComboBox ItemsSource="{Binding ProfileOptions}" SelectedItem="{Binding SelectedProfile}" ItemTemplate="{StaticResource ProfileItem}"
                                  MinWidth="200" Margin="0,4,16,4" ToolTip="{l:Tr Profile_Label}" />
                        <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Display" MinWidth="220" Margin="0,4,16,4" />
                        <ui:ToggleSwitch Content="{l:Tr Tweaks_OnlyProfile}" IsChecked="{Binding OnlyProfile}" Margin="0,4,16,4" />
                        <ui:ToggleSwitch Content="{l:Tr Tweaks_OnlyRecommended}" IsChecked="{Binding OnlyRecommended}" Margin="0,4,16,4" />
                        <ui:ToggleSwitch Content="{l:Tr Dash_ShowAll}" IsChecked="{Binding ShowPassed}" Margin="0,4,0,4" />
                    </WrapPanel>
                </DockPanel>
            </ui:Card>

            <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding TweaksSummary}" Margin="0,0,0,8" />
            <ItemsControl ItemsSource="{Binding Tweaks}" ItemTemplate="{StaticResource TweakRow}" />
            <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Empty_List}" Visibility="{Binding Tweaks.Count, Converter={StaticResource EmptyToVisibility}}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
