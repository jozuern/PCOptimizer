<UserControl x:Class="Optimizer.App.Views.TweaksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:Optimizer.App.Services"
             xmlns:v="clr-namespace:Optimizer.App.Views"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <!-- Header and filters stay in place; the tweak list scrolls on its own and builds only the cards in view. -->
    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <ui:TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr Tweaks_Title}" />
            <ui:TextBlock Style="{StaticResource PageIntro}" Text="{l:Tr Tweaks_Hint}" />

            <ui:InfoBar Title="" Message="{l:Tr Banner_AdminToApply}" Severity="Warning" IsClosable="False"
                        IsOpen="{Binding IsElevated, Converter={StaticResource InverseBool}}" Margin="0,0,0,8" />

            <!-- Filters and Apply recommended: search and the profile on one row (the search box takes the rest), the
                 switches below. The categories are the groups of the list, so they need no picker here. -->
            <ui:Card Padding="16,12" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="120" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ui:TextBox PlaceholderText="{l:Tr Tweaks_Search}" Icon="{ui:SymbolIcon Search20}" Text="{Binding TweakSearch, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                Margin="0,4,8,4" ClearButtonEnabled="True" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding ProfileOptions}" SelectedItem="{Binding SelectedProfile}" ItemTemplate="{StaticResource ProfileItem}"
                              MinWidth="180" Margin="0,4,0,4" ToolTip="{l:Tr Profile_Label}" AutomationProperties.Name="{l:Tr Profile_Label}" />
                    <DockPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4,0,0">
                        <ui:Button DockPanel.Dock="Right" Appearance="Primary" Content="{Binding RecommendedButtonText}" Command="{Binding ApplyRecommendedCommand}"
                                   Visibility="{Binding HasRecommendations, Converter={StaticResource BoolToVisibility}}" VerticalAlignment="Center" Margin="16,0,0,0" />
                        <WrapPanel>
                            <ui:ToggleSwitch Content="{l:Tr Tweaks_OnlyProfile}" IsChecked="{Binding OnlyProfile}" Margin="0,4,24,4" />
                            <ui:ToggleSwitch Content="{l:Tr Tweaks_OnlyRecommended}" IsChecked="{Binding OnlyRecommended}" Margin="0,4,24,4" />
                            <ui:ToggleSwitch Content="{l:Tr Tweaks_ShowNotApplicable}" IsChecked="{Binding ShowPassed}" Margin="0,4,0,4" />
                        </WrapPanel>
                    </DockPanel>
                </Grid>
            </ui:Card>

            <!-- Counts on the left, open or close every group on the right -->
            <DockPanel Margin="0,0,0,4">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ui:Button Appearance="Transparent" Content="{l:Tr Tweaks_OpenAll}" Icon="{ui:SymbolIcon ChevronDown20}" Command="{Binding OpenAllTweakGroupsCommand}" Margin="0,0,4,0" />
                    <ui:Button Appearance="Transparent" Content="{l:Tr Tweaks_CloseAll}" Icon="{ui:SymbolIcon ChevronUp20}" Command="{Binding CloseAllTweakGroupsCommand}" />
                </StackPanel>
                <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding TweaksSummary}" VerticalAlignment="Center" />
            </DockPanel>
            <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Empty_List}" Visibility="{Binding Tweaks.Count, Converter={StaticResource EmptyToVisibility}}" />
        </StackPanel>
        <!-- One list for the group headings and the tweaks of the open groups, so only the cards in view are built. The
             tweaks are indented under their heading. -->
        <ItemsControl Grid.Row="1" Style="{StaticResource VirtualCardList}" ItemsSource="{Binding TweakRows}">
            <ItemsControl.ItemTemplateSelector>
                <v:TweakListTemplateSelector>
                    <v:TweakListTemplateSelector.Group>
                        <DataTemplate>
                            <ui:CardControl Margin="{StaticResource CardRowMargin}" Padding="{StaticResource CardPadding}" AutomationProperties.Name="{Binding AutomationName}"
                                            Command="{Binding DataContext.ToggleTweakGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                <ui:CardControl.Icon>
                                    <ui:SymbolIcon Symbol="{Binding Icon}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                </ui:CardControl.Icon>
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Title}" TextWrapping="Wrap" />
                                        <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Summary}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:SymbolIcon Symbol="{Binding Chevron}" FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </ui:CardControl>
                        </DataTemplate>
                    </v:TweakListTemplateSelector.Group>
                    <v:TweakListTemplateSelector.Tweak>
                        <DataTemplate>
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource TweakRow}" Margin="24,0,0,0" />
                        </DataTemplate>
                    </v:TweakListTemplateSelector.Tweak>
                </v:TweakListTemplateSelector>
            </ItemsControl.ItemTemplateSelector>
        </ItemsControl>
    </Grid>
</UserControl>
