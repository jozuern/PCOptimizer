<UserControl x:Class="Optimizer.App.Views.ChangesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:Optimizer.App.Services"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource PagePadding}">
            <ui:TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr Changes_Title}" />
            <ui:TextBlock Style="{StaticResource PageIntro}" Text="{l:Tr Changes_Hint}" />

            <ui:TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr Changes_Safety}" Margin="0,0,0,8" />
            <ui:CardControl Padding="{StaticResource CardPadding}">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="ShieldCheckmark24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Changes_RestorePoints}" />
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding RestorePointText}" Margin="0,4,0,0" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Content="{l:Tr Changes_EnableRp}" Command="{Binding EnableRestorePointsCommand}" Visibility="{Binding CanEnableRestorePoints, Converter={StaticResource BoolToVisibility}}" />
            </ui:CardControl>

            <DockPanel Margin="0,24,0,8">
                <ui:Button DockPanel.Dock="Right" Content="{l:Tr Changes_UndoAll}" Icon="{ui:SymbolIcon ArrowUndo20}" Command="{Binding UndoAllCommand}"
                           Visibility="{Binding ChangesEmpty, Converter={StaticResource InverseBoolToVisibility}}" />
                <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Changes_Backups}" VerticalAlignment="Center" />
            </DockPanel>
            <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Changes_Empty}" Visibility="{Binding ChangesEmpty, Converter={StaticResource BoolToVisibility}}" />
            <ItemsControl ItemsSource="{Binding ChangeRecords}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:CardControl Margin="{StaticResource CardRowMargin}" Padding="{StaticResource CardPadding}">
                            <ui:CardControl.Icon>
                                <ui:SymbolIcon Symbol="{Binding Status, Converter={StaticResource StatusToSymbol}}" Filled="True" Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}" />
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Title}" TextWrapping="Wrap" />
                                    <ui:TextBlock FontTypography="Caption" Appearance="Secondary" Margin="0,4,0,0">
                                        <Run Text="{Binding When, Mode=OneWay}" /><Run Text=", " /><Run Text="{Binding Details, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding StateText, Mode=OneWay}" />
                                    </ui:TextBlock>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:Button Content="{l:Tr Tweak_Undo}" Icon="{ui:SymbolIcon ArrowUndo20}" IsEnabled="{Binding CanUndo}"
                                       Command="{Binding DataContext.UndoRecordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding TweakId}" />
                        </ui:CardControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ui:TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr Changes_Log}" />
            <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Changes_LogEmpty}" Visibility="{Binding ChangeLogEmpty, Converter={StaticResource BoolToVisibility}}" />
            <ui:Card Padding="16,12" Visibility="{Binding ChangeLogEmpty, Converter={StaticResource InverseBoolToVisibility}}">
                <ItemsControl ItemsSource="{Binding ChangeLog}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Mono}" Text="{Binding Time}" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Mono}" Text="{Binding Text}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
