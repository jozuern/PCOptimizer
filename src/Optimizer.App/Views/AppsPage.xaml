<UserControl x:Class="Optimizer.App.Views.AppsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:Optimizer.App.Services"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource PagePadding}">
            <DockPanel>
                <ui:Button DockPanel.Dock="Right" Content="{l:Tr Common_Refresh}" Icon="{ui:SymbolIcon ArrowSync20}" Command="{Binding Apps.ReloadCommand}" VerticalAlignment="Top" />
                <StackPanel>
                    <ui:TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr Apps_Title}" />
                    <ui:TextBlock Style="{StaticResource PageIntro}" Text="{l:Tr Apps_Hint}" />
                </StackPanel>
            </DockPanel>
            <ui:InfoBar Title="" Message="{l:Tr Apps_NoWinget}" Severity="Warning" IsClosable="False" IsOpen="{Binding Apps.WingetMissing}" Margin="0,0,0,8" />
            <ui:Button Content="{l:Tr Apps_GetAppInstaller}" Icon="{ui:SymbolIcon Open20}" Margin="0,0,0,8"
                       Command="{Binding OpenLinkCommand}" CommandParameter="https://apps.microsoft.com/detail/9nblggh4nns1"
                       Visibility="{Binding Apps.WingetMissing, Converter={StaticResource BoolToVisibility}}" />
            <ui:ProgressRing IsIndeterminate="True" Width="24" Height="24" HorizontalAlignment="Left" Margin="0,0,0,8" Visibility="{Binding Apps.IsLoading, Converter={StaticResource BoolToVisibility}}" />

            <ItemsControl ItemsSource="{Binding Apps.Apps}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:CardControl Margin="{StaticResource CardRowMargin}" Padding="{StaticResource CardPadding}">
                            <ui:CardControl.Icon>
                                <ui:SymbolIcon Symbol="{Binding Symbol}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Name}" />
                                    <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Text}" Margin="0,4,0,0" />
                                    <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Category}" Margin="0,4,0,0" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBlock FontTypography="Caption" Text="{Binding StateText}" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <ui:TextBlock.Style>
                                        <Style TargetType="ui:TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Installed}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:TextBlock.Style>
                                </ui:TextBlock>
                                <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="0,0,12,0" Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVisibility}}" />
                                <ui:Button Content="{l:Tr Apps_Install}" Icon="{ui:SymbolIcon ArrowDownload20}"
                                           Visibility="{Binding Installed, Converter={StaticResource InverseBoolToVisibility}}"
                                           IsEnabled="{Binding IsInstalling, Converter={StaticResource InverseBool}}"
                                           Command="{Binding DataContext.Apps.InstallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                            </StackPanel>
                        </ui:CardControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBox Style="{StaticResource OutputBox}" Text="{Binding Apps.Output, Mode=OneWay}" Visibility="{Binding Apps.Output, Converter={StaticResource NullToVisibility}}" />

            <ui:Button Content="{l:Tr Apps_UpdateAll}" Icon="{ui:SymbolIcon ArrowSync20}" Margin="0,8,0,0" Command="{Binding Apps.UpdateAllCommand}"
                       IsEnabled="{Binding Apps.IsUpdatingAll, Converter={StaticResource InverseBool}}" />

            <ui:TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr Programs_Title}" />
            <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Programs_Hint}" Margin="0,0,0,8" TextWrapping="Wrap" />
            <DockPanel Margin="0,0,0,8">
                <ui:TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" Text="{Binding Apps.ProgramsText}" VerticalAlignment="Center" Margin="12,0,0,0" />
                <ui:TextBox PlaceholderText="{l:Tr Programs_Search}" Icon="{ui:SymbolIcon Search20}" Text="{Binding Apps.ProgramSearch, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>
            <ItemsControl ItemsSource="{Binding Apps.ProgramRows}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" MaxHeight="520"
                          VirtualizingPanel.ScrollUnit="Pixel" Template="{StaticResource VirtualList}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:CardControl Margin="{StaticResource CardRowMargin}" Padding="{StaticResource CardPadding}">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Name}" TextWrapping="Wrap" />
                                    <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Meta}" Margin="0,4,0,0" />
                                    <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding StateText}" Margin="0,4,0,0" TextWrapping="Wrap"
                                                  Visibility="{Binding StateText, Converter={StaticResource NullToVisibility}}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="0,0,12,0" Visibility="{Binding IsRemoving, Converter={StaticResource BoolToVisibility}}" />
                                <ui:Button Content="{l:Tr Programs_Uninstall}" Icon="{ui:SymbolIcon Delete20}" IsEnabled="{Binding IsRemoving, Converter={StaticResource InverseBool}}"
                                           Command="{Binding DataContext.Apps.UninstallProgramCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                            </StackPanel>
                        </ui:CardControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ui:TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr Drv_Title}" />
            <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Drv_Hint}" Margin="0,0,0,8" />
            <ui:CardControl Padding="{StaticResource CardPadding}" Margin="{StaticResource CardRowMargin}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Drv_CleanTitle}" />
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Drv_CleanHint}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Content="{l:Tr Drv_CleanOpen}" Icon="{ui:SymbolIcon Open20}" Command="{Binding OpenLinkCommand}"
                           CommandParameter="https://www.guru3d.com/download/display-driver-uninstaller-download/" />
            </ui:CardControl>
            <ItemsControl ItemsSource="{Binding Apps.Drivers}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:CardControl Margin="{StaticResource CardRowMargin}" Padding="{StaticResource CardPadding}">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Device}" TextWrapping="Wrap" />
                                    <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0">
                                        <Run Text="{Binding MetaText, Mode=OneWay}" />
                                    </ui:TextBlock>
                                    <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,4,0,0">
                                        <Run Text="{Binding DateText, Mode=OneWay}" />
                                    </ui:TextBlock>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:Button Content="{l:Tr Drv_Update}" Icon="{ui:SymbolIcon Open20}" Visibility="{Binding UpdateUrl, Converter={StaticResource NullToVisibility}}"
                                       Command="{Binding DataContext.Apps.OpenDriverPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding UpdateUrl}" />
                        </ui:CardControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
