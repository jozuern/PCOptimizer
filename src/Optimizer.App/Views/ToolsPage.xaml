<UserControl x:Class="Optimizer.App.Views.ToolsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:s="clr-namespace:Optimizer.App.Services"
             xmlns:l="clr-namespace:Optimizer.App.Services"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource PagePadding}">
            <ui:TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr Tools_Title}" />
            <ui:TextBlock Style="{StaticResource PageIntro}" Text="{l:Tr Tools_Hint}" />

            <!-- Storage analyzer -->
            <ui:TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr Storage_Title}" Margin="0,0,0,8" />
            <ui:Card Padding="16,12">
                <StackPanel>
                    <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Storage_Hint}" />
                    <WrapPanel Margin="0,8,0,0">
                        <ComboBox ItemsSource="{Binding Tools.Drives}" SelectedItem="{Binding Tools.SelectedDrive}" MinWidth="120" Margin="0,0,8,0" />
                        <ui:Button Appearance="Primary" Content="{l:Tr Storage_Scan}" Icon="{ui:SymbolIcon Search20}" Command="{Binding Tools.ScanStorageCommand}"
                                   IsEnabled="{Binding Tools.IsScanningStorage, Converter={StaticResource InverseBool}}" Margin="0,0,8,0" />
                        <ui:Button Content="{l:Tr Common_Stop}" Command="{Binding Tools.StopStorageCommand}" Visibility="{Binding Tools.IsScanningStorage, Converter={StaticResource BoolToVisibility}}" Margin="0,0,8,0" />
                        <ui:Button Content="{l:Tr Storage_Recycle}" Icon="{ui:SymbolIcon Delete20}" Command="{Binding Tools.RecycleSelectedCommand}" />
                    </WrapPanel>
                    <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Tools.StorageStatus}" Margin="0,8,0,0" Visibility="{Binding Tools.StorageStatus, Converter={StaticResource NullToVisibility}}" />
                </StackPanel>
            </ui:Card>
            <ui:CardExpander Header="{l:Tr Storage_Largest}" Margin="0,4,0,0" Visibility="{Binding Tools.LargestFiles.Count, Converter={StaticResource CountToVisibility}}">
                <ItemsControl ItemsSource="{Binding Tools.LargestFiles}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,4">
                                <ui:TextBlock DockPanel.Dock="Right" FontTypography="Body" Text="{Binding SizeText}" Margin="16,0,0,0" />
                                <CheckBox IsChecked="{Binding Selected}" IsEnabled="{Binding CanDelete}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Mono}" Text="{Binding Path}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Meta}" />
                                    </StackPanel>
                                </CheckBox>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ui:CardExpander>
            <ui:CardExpander Header="{l:Tr Storage_Folders}" Margin="0,4,0,0" Visibility="{Binding Tools.LargestFolders.Count, Converter={StaticResource CountToVisibility}}">
                <ItemsControl ItemsSource="{Binding Tools.LargestFolders}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,4">
                                <ui:TextBlock DockPanel.Dock="Right" FontTypography="Body" Text="{Binding SizeText}" Margin="16,0,0,0" />
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Mono}" Text="{Binding Path}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Files}" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ui:CardExpander>
            <ui:CardExpander Header="{l:Tr Storage_Duplicates}" Margin="0,4,0,0" Visibility="{Binding Tools.Duplicates.Count, Converter={StaticResource CountToVisibility}}">
                <ItemsControl ItemsSource="{Binding Tools.Duplicates}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,4">
                                <ui:TextBlock DockPanel.Dock="Right" FontTypography="Body" Text="{Binding SizeText}" Margin="16,0,0,0" />
                                <CheckBox IsChecked="{Binding Selected}" IsEnabled="{Binding CanDelete}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Mono}" Text="{Binding Path}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Meta}" />
                                    </StackPanel>
                                </CheckBox>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ui:CardExpander>

            <!-- Optional features -->
            <ui:TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr Feat_Title}" />
            <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Feat_Hint}" Margin="0,0,0,8" />
            <ui:ProgressRing IsIndeterminate="True" Width="24" Height="24" HorizontalAlignment="Left" Margin="0,0,0,8" Visibility="{Binding Tools.IsLoading, Converter={StaticResource BoolToVisibility}}" />
            <ui:InfoBar Title="" Message="{Binding Tools.FeaturesNote}" Severity="Informational" IsClosable="False" Margin="0,0,0,8"
                        IsOpen="{Binding Tools.FeaturesNote, Converter={StaticResource NullToBool}}" />
            <ItemsControl ItemsSource="{Binding Tools.Features}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:CardControl Margin="{StaticResource CardRowMargin}" Padding="{StaticResource CardPadding}">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Title}" />
                                    <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Text}" Margin="0,4,0,0" />
                                    <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="{Binding Note}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                  Visibility="{Binding Note, Converter={StaticResource NullToVisibility}}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch IsChecked="{Binding SwitchState, Mode=TwoWay}" >
                                <ui:ToggleSwitch.IsEnabled>
                                    <MultiBinding Converter="{StaticResource AllTrue}">
                                        <Binding Path="CanToggle" />
                                        <Binding Path="CanChange" Source="{x:Static s:ChangeGate.Instance}" />
                                    </MultiBinding>
                                </ui:ToggleSwitch.IsEnabled>
                            </ui:ToggleSwitch>
                        </ui:CardControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Windows Update repair -->
            <ui:TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr Repair_Title}" />
            <ui:CardControl Padding="{StaticResource CardPadding}">
                <ui:CardControl.Header>
                    <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Repair_Hint}" />
                </ui:CardControl.Header>
                <ui:Button Content="{l:Tr Repair_Run}" Icon="{ui:SymbolIcon ArrowSync20}" Command="{Binding Tools.RepairUpdateCommand}"
                           IsEnabled="{Binding Tools.IsWorking, Converter={StaticResource InverseBool}}" />
            </ui:CardControl>
            <ItemsControl ItemsSource="{Binding Tools.RepairSteps}" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <ui:TextBlock FontTypography="Body" Text="{Binding Text}" />
                            <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Detail}" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Quick tools -->
            <ui:TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr Quick_Title}" />
            <ui:CardControl Padding="{StaticResource CardPadding}" Margin="{StaticResource CardRowMargin}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Quick_Dns}" />
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Quick_DnsHint}" Margin="0,4,0,0" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Content="{l:Tr Cleanup_Run}" Command="{Binding Tools.FlushDnsCommand}" />
            </ui:CardControl>
            <ui:CardControl Padding="{StaticResource CardPadding}" Margin="{StaticResource CardRowMargin}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Quick_Explorer}" />
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Quick_ExplorerHint}" Margin="0,4,0,0" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Content="{l:Tr Cleanup_Run}" Command="{Binding Tools.RestartExplorerCommand}" />
            </ui:CardControl>
            <ui:CardControl Padding="{StaticResource CardPadding}" Margin="{StaticResource CardRowMargin}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Quick_Winsock}" />
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Quick_WinsockHint}" Margin="0,4,0,0" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Content="{l:Tr Cleanup_Run}" Command="{Binding Tools.WinsockResetCommand}" />
            </ui:CardControl>
            <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Tools.QuickOutput}" Margin="0,8,0,0" Visibility="{Binding Tools.QuickOutput, Converter={StaticResource NullToVisibility}}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
