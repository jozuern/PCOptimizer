<UserControl x:Class="Optimizer.App.Views.HealthPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:v="clr-namespace:Optimizer.App.Views"
             xmlns:l="clr-namespace:Optimizer.App.Services"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource PageRoot}">
            <ui:TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr Health_Title}" />
            <ui:TextBlock Style="{StaticResource PageIntro}" Text="{l:Tr Health_Hint}" />

            <!-- Throttle check -->
            <ui:TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr Throttle_Title}" Margin="0,0,0,8" />
            <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Throttle_Hint}" Margin="0,0,0,8" />
            <ui:Card Padding="16,12">
                <StackPanel>
                    <WrapPanel>
                        <ComboBox ItemsSource="{Binding Health.DurationOptions}" SelectedItem="{Binding Health.ThrottleSeconds}" ItemStringFormat="{}{0} s" MinWidth="100" Margin="0,0,8,0" AutomationProperties.Name="{l:Tr Bench_Duration}" />
                        <ui:Button Appearance="Primary" Content="{l:Tr Throttle_Start}" Icon="{ui:SymbolIcon Play20}" Command="{Binding Health.StartThrottleCommand}"
                                   IsEnabled="{Binding Health.IsThrottleRunning, Converter={StaticResource InverseBool}}" Margin="0,0,8,0" />
                        <ui:Button Content="{l:Tr Common_Stop}" Icon="{ui:SymbolIcon Stop20}" Command="{Binding Health.StopThrottleCommand}"
                                   Visibility="{Binding Health.IsThrottleRunning, Converter={StaticResource BoolToVisibility}}" />
                    </WrapPanel>
                    <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Health.ThrottleStatus}" Margin="0,8,0,0" Visibility="{Binding Health.ThrottleStatus, Converter={StaticResource NullToVisibility}}" />
                    <ui:TextBlock FontTypography="Body" Text="{Binding Health.ThrottleResult}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding Health.ThrottleResult, Converter={StaticResource NullToVisibility}}" />
                </StackPanel>
            </ui:Card>

            <!-- Benchmark -->
            <ui:TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr Bench_Title}" />
            <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Bench_Hint}" Margin="0,0,0,4" />

            <ui:Card Padding="16,12">
                <StackPanel>
                    <!-- Where the measurement stands: four marks (reached ones in the accent color), "Step 2 of 4" and what to do now -->
                    <UniformGrid Rows="1" Columns="4" Width="240" HorizontalAlignment="Left" Margin="0,4,0,8">
                        <UniformGrid.Resources>
                            <Style x:Key="StepMark" TargetType="Border">
                                <Setter Property="Height" Value="4" />
                                <Setter Property="CornerRadius" Value="2" />
                                <Setter Property="Margin" Value="0,0,4,0" />
                                <Setter Property="Background" Value="{DynamicResource ControlStrongFillColorDisabledBrush}" />
                            </Style>
                        </UniformGrid.Resources>
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource StepMark}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Health.BenchmarkStepNumber, Converter={StaticResource AtLeast}, ConverterParameter=1}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource StepMark}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Health.BenchmarkStepNumber, Converter={StaticResource AtLeast}, ConverterParameter=2}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource StepMark}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Health.BenchmarkStepNumber, Converter={StaticResource AtLeast}, ConverterParameter=3}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource StepMark}">
                                    <Setter Property="Margin" Value="0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Health.BenchmarkStepNumber, Converter={StaticResource AtLeast}, ConverterParameter=4}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </UniformGrid>
                    <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Health.BenchmarkStepLabel}" />
                    <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Health.BenchmarkStep}" TextWrapping="Wrap" Margin="0,2,0,12" />
                    <WrapPanel>
                        <!-- A combo box has no placeholder: the hint lies over it until a game is picked -->
                        <Grid Margin="0,0,8,8">
                            <ComboBox ItemsSource="{Binding Health.Processes}" SelectedItem="{Binding Health.SelectedProcess}" MinWidth="220" AutomationProperties.Name="{l:Tr Bench_Game}" />
                            <ui:TextBlock FontTypography="Body" Text="{l:Tr Bench_PickGame}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="12,0,32,0"
                                          VerticalAlignment="Center" IsHitTestVisible="False"
                                          Visibility="{Binding Health.SelectedProcess, Converter={StaticResource VisibleWhenNull}}" />
                        </Grid>
                        <ui:Button Icon="{ui:SymbolIcon ArrowSync20}" Command="{Binding Health.RefreshProcessesCommand}" ToolTip="{l:Tr Common_Refresh}" AutomationProperties.Name="{l:Tr Common_Refresh}" Margin="0,0,8,8" />
                        <ComboBox ItemsSource="{Binding Health.CaptureOptions}" SelectedItem="{Binding Health.CaptureSeconds}" ItemStringFormat="{}{0} s" MinWidth="100" Margin="0,0,16,8" AutomationProperties.Name="{l:Tr Bench_Duration}" />
                        <ui:Button Content="{l:Tr Bench_Before}" Command="{Binding Health.CaptureBeforeCommand}" IsEnabled="{Binding Health.CanCaptureBefore}" Margin="0,0,8,8" />
                        <ui:Button Content="{l:Tr Bench_After}" Command="{Binding Health.CaptureAfterCommand}" IsEnabled="{Binding Health.CanCaptureAfter}" Margin="0,0,8,8" />
                        <ui:Button Content="{l:Tr Common_Stop}" Command="{Binding Health.StopCaptureCommand}" Margin="0,0,8,8"
                                   Visibility="{Binding Health.IsCapturing, Converter={StaticResource BoolToVisibility}}" />
                        <ui:Button Content="{l:Tr Bench_Clear}" Appearance="Transparent" Command="{Binding Health.ClearRunsCommand}" Margin="0,0,0,8"
                                   Visibility="{Binding Health.HasRuns, Converter={StaticResource BoolToVisibility}}" />
                    </WrapPanel>
                    <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Health.BenchmarkStatus}" Margin="0,8,0,0" Visibility="{Binding Health.BenchmarkStatus, Converter={StaticResource NullToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding Health.Runs}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Label}" />
                                    <ui:TextBlock Grid.Column="1" FontTypography="Body" Text="{Binding AvgFps}" />
                                    <ui:TextBlock Grid.Column="2" FontTypography="Body" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Low}" />
                                    <ui:TextBlock Grid.Column="3" FontTypography="Caption" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Frames}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Health.ComparisonText}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding Health.ComparisonText, Converter={StaticResource NullToVisibility}}" />
                </StackPanel>
            </ui:Card>

            <!-- Drives -->
            <ui:TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr Health_Disks}" />
            <ItemsControl ItemsSource="{Binding Health.Disks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:CardControl Margin="{StaticResource CardRowMargin}" Padding="{StaticResource CardPadding}">
                            <ui:CardControl.Icon>
                                <ui:SymbolIcon Symbol="{Binding Status, Converter={StaticResource StatusToSymbol}}" Filled="True" v:ThemeBrush.Status="{Binding Status}" />
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Name}" TextWrapping="Wrap" />
                                    <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Details}" Margin="0,4,0,0" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:TextBlock FontTypography="Body" Text="{Binding Health}" />
                        </ui:CardControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Sensors (opt-in) -->
            <ui:TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr Sensors_Title}" />
            <ui:CardControl Padding="{StaticResource CardPadding}">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="Temperature24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Sensors_Live}" />
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Sensors_Hint}" Margin="0,4,0,0" />
                        <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Health.PawnIoText}" Margin="0,4,0,0" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:Button Content="{l:Tr Sensors_InstallPawnIo}" Margin="0,0,16,0" Command="{Binding Health.InstallPawnIoCommand}"
                               Visibility="{Binding Health.CanInstallPawnIo, Converter={StaticResource BoolToVisibility}}" />
                    <ui:ToggleSwitch AutomationProperties.Name="{l:Tr Sensors_Live}" IsChecked="{Binding Health.SensorsOn}" OnContent="{l:Tr Feature_On}" OffContent="{l:Tr Feature_Off}" />
                </StackPanel>
            </ui:CardControl>
            <ItemsControl ItemsSource="{Binding Health.SensorRows}" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Hardware}" TextWrapping="Wrap" />
                            <ui:TextBlock Grid.Column="1" FontTypography="Body" Text="{Binding Sensor}" TextWrapping="Wrap" />
                            <ui:TextBlock Grid.Column="2" FontTypography="BodyStrong" Text="{Binding Value}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
