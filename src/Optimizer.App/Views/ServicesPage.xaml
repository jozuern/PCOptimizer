<UserControl x:Class="Optimizer.App.Views.ServicesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:s="clr-namespace:Optimizer.App.Services"
             xmlns:l="clr-namespace:Optimizer.App.Services"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <UserControl.Resources>
        <!-- Tabs drawn like the Windows 11 selector bar: the selected tab gets an accent line under its text. -->
        <Style x:Key="SelectorTab" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="4" Padding="12,6,12,4" Margin="0,0,4,0">
                            <StackPanel>
                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                                <Border x:Name="Pill" Height="3" Width="16" CornerRadius="1.5" Margin="0,4,0,0" HorizontalAlignment="Center"
                                        Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Hidden" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0">
            <ui:Button DockPanel.Dock="Right" Content="{l:Tr Common_Refresh}" Icon="{ui:SymbolIcon ArrowSync20}" Command="{Binding ServicesPage.ReloadCommand}" VerticalAlignment="Top" />
            <StackPanel>
                <ui:TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr Svc_Title}" />
                <ui:TextBlock Style="{StaticResource PageIntro}" Text="{l:Tr Svc_Hint}" />
            </StackPanel>
        </DockPanel>

        <TabControl Grid.Row="1" ItemContainerStyle="{StaticResource SelectorTab}">
            <TabItem Header="{l:Tr Svc_TabServices}">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ui:Card Padding="16,12" Margin="0,0,0,8">
                        <StackPanel>
                            <WrapPanel>
                                <ui:TextBox PlaceholderText="{l:Tr Svc_Search}" Text="{Binding ServicesPage.Search, UpdateSourceTrigger=PropertyChanged}" MinWidth="280" Margin="0,0,16,0"
                                            Icon="{ui:SymbolIcon Search20}" />
                                <ui:ToggleSwitch Content="{l:Tr Svc_ShowWindows}" IsChecked="{Binding ServicesPage.ShowWindowsServices}" />
                            </WrapPanel>
                            <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Svc_Rules}" Margin="0,8,0,0" />
                            <ui:ProgressRing IsIndeterminate="True" Width="24" Height="24" HorizontalAlignment="Left" Margin="0,8,0,0"
                                             Visibility="{Binding ServicesPage.IsLoading, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </ui:Card>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding ServicesPage.Rows}" Style="{StaticResource VirtualCardList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:Card Padding="{StaticResource CardPadding}" Margin="{StaticResource CardRowMargin}">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0" Width="200">
                                            <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}" DisplayMemberPath="Text"
                                                      Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}" />
                                            <ui:TextBlock FontTypography="Body" Text="{Binding StartText}"
                                                          Visibility="{Binding CanEdit, Converter={StaticResource InverseBoolToVisibility}}" />
                                            <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding EditText}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                          Visibility="{Binding EditText, Converter={StaticResource NullToVisibility}}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <ui:TextBlock FontTypography="BodyStrong" Text="{Binding DisplayName}" TextWrapping="Wrap" />
                                            <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding MetaText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                            <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Text="{Binding Note}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                          Visibility="{Binding Note, Converter={StaticResource NullToVisibility}}" />
                                            <!-- Windows' own description can run to five lines: two lines here, all of it in the tooltip -->
                                            <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Description}" Margin="0,4,0,0" ToolTip="{Binding Description}"
                                                          TextTrimming="CharacterEllipsis" LineStackingStrategy="BlockLineHeight" LineHeight="16" MaxHeight="32"
                                                          Visibility="{Binding Description, Converter={StaticResource NullToVisibility}}" />
                                        </StackPanel>
                                    </DockPanel>
                                </ui:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </TabItem>
            <TabItem Header="{l:Tr Svc_TabTasks}">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ui:Card Padding="16,12" Margin="0,0,0,8">
                        <StackPanel>
                            <ui:ToggleSwitch Content="{l:Tr Task_ShowMicrosoft}" IsChecked="{Binding ServicesPage.ShowMicrosoftTasks}" />
                            <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Task_Hint}" Margin="0,8,0,0" />
                        </StackPanel>
                    </ui:Card>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding ServicesPage.Tasks}" Style="{StaticResource VirtualCardList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:Card Padding="{StaticResource CardPadding}" Margin="{StaticResource CardRowMargin}">
                                    <DockPanel>
                                        <ui:ToggleSwitch DockPanel.Dock="Right" AutomationProperties.Name="{Binding Name}" IsChecked="{Binding SwitchState, Mode=TwoWay}" Margin="16,0,0,0" VerticalAlignment="Center">
                                            <ui:ToggleSwitch.IsEnabled>
                                                <MultiBinding Converter="{StaticResource AllTrue}">
                                                    <Binding Path="CanToggle" />
                                                    <Binding Path="CanChange" Source="{x:Static s:ChangeGate.Instance}" />
                                                </MultiBinding>
                                            </ui:ToggleSwitch.IsEnabled>
                                        </ui:ToggleSwitch>
                                        <StackPanel>
                                            <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Name}" TextWrapping="Wrap" />
                                            <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Location}" Margin="0,4,0,0" />
                                            <TextBlock Style="{StaticResource Mono}" Text="{Binding Command}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </ui:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
