<UserControl x:Class="Optimizer.App.Views.OverviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:Optimizer.App.Services"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource PagePadding}">
            <DockPanel>
                <ui:Button DockPanel.Dock="Right" Content="{l:Tr Scan_Again}" Icon="{ui:SymbolIcon ArrowSync20}" Command="{Binding ScanCommand}" VerticalAlignment="Top" />
                <StackPanel>
                    <ui:TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr Dash_Title}" />
                    <ui:TextBlock Style="{StaticResource PageIntro}" Text="{Binding Headline}" />
                </StackPanel>
            </DockPanel>

            <ItemsControl ItemsSource="{Binding Banners}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:InfoBar Title="" Message="{Binding Text}" Severity="{Binding Severity}" IsOpen="True" IsClosable="False" Margin="0,0,0,8" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Readiness and counts -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:Card Grid.Column="0" Padding="24,16" VerticalAlignment="Stretch">
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Dash_Score}" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <ui:TextBlock FontTypography="TitleLarge" Text="{Binding Score}" Foreground="{Binding ScoreStatus, Converter={StaticResource StatusToBrush}}" />
                            <ui:TextBlock FontTypography="Subtitle" Appearance="Tertiary" Text=" / 100" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                        </StackPanel>
                        <ProgressBar Value="{Binding Score}" Maximum="100" Height="4" Margin="0,8,0,8" Foreground="{Binding ScoreStatus, Converter={StaticResource StatusToBrush}}" />
                        <ui:TextBlock FontTypography="Body" Text="{Binding ScoreVerdict}" />
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Dash_ScoreHint}" Margin="0,4,0,0" />
                    </StackPanel>
                </ui:Card>
                <ui:Card Grid.Column="2" Padding="24,16" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="{Binding ProblemSummary}" />
                        <ItemsControl ItemsSource="{Binding Counts}" Margin="0,8,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <ui:TextBlock FontTypography="Title" Text="{Binding Value}" Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}" />
                                        <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Label}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ui:Card>
            </Grid>

            <!-- Apply recommended -->
            <ui:TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr Rec_Section}" />
            <ui:Card Padding="24,16">
                <StackPanel>
                    <DockPanel>
                        <ui:Button DockPanel.Dock="Right" Appearance="Primary" Content="{Binding RecommendedButtonText}" Command="{Binding ApplyRecommendedCommand}"
                                   IsEnabled="{Binding HasRecommendations}" VerticalAlignment="Top" />
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Rec_Intro}" Margin="0,0,16,0" />
                    </DockPanel>
                    <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Rec_Empty}" Margin="0,8,0,0"
                                  Visibility="{Binding HasRecommendations, Converter={StaticResource InverseBoolToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding Recommendations}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <ui:TextBlock FontTypography="Body" Text="{Binding Title}" TextWrapping="Wrap" />
                                        <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Reason}" />
                                    </StackPanel>
                                    <ui:TextBlock Grid.Column="1" FontTypography="Caption" Appearance="Secondary" Text="{Binding ImpactText}" Margin="16,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ui:CardExpander Header="{l:Tr Rec_ExcludedTitle}" Margin="0,8,0,0" Padding="16,8"
                                     Visibility="{Binding RecommendationsExcluded.Count, Converter={StaticResource CountToVisibility}}">
                        <ItemsControl ItemsSource="{Binding RecommendationsExcluded}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4">
                                        <ui:TextBlock FontTypography="Body" Text="{Binding Title}" TextWrapping="Wrap" />
                                        <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Reason}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ui:CardExpander>
                </StackPanel>
            </ui:Card>

            <!-- Findings -->
            <DockPanel Margin="0,24,0,8">
                <CheckBox DockPanel.Dock="Right" Content="{l:Tr Dash_ShowAll}" IsChecked="{Binding ShowPassed}" />
                <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Dash_Findings}" VerticalAlignment="Center" />
            </DockPanel>
            <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Empty_List}" Visibility="{Binding FindingsEmpty, Converter={StaticResource BoolToVisibility}}" />
            <ItemsControl ItemsSource="{Binding Findings}" ItemTemplate="{StaticResource FindingRow}" />

            <!-- Game access -->
            <ui:TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr Dash_GameAccess}" />
            <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Dash_GameAccessHint}" Margin="0,0,0,8" />
            <ContentControl Content="{Binding GameAccess}" ContentTemplate="{StaticResource FindingRow}" />

            <!-- This PC -->
            <ui:TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr Dash_YourPc}" />
            <ui:Card Padding="24,16">
                <ItemsControl ItemsSource="{Binding Summary}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBlock FontTypography="Body" Appearance="Secondary" Text="{Binding Label}" />
                                <ui:TextBlock Grid.Column="1" FontTypography="Body" Text="{Binding Value}" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
