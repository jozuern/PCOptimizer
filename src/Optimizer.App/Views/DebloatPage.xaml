<UserControl x:Class="Optimizer.App.Views.DebloatPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:Optimizer.App.Services"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <!-- Everything that removes apps in one place: Store apps that came with Windows, and desktop programs -->
    <Grid Style="{StaticResource PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0">
            <!-- One Refresh for the page, as on the other pages: it reads the open tab again (F5 does the same) -->
            <ui:Button DockPanel.Dock="Right" Content="{l:Tr Common_Refresh}" Icon="{ui:SymbolIcon ArrowClockwise20}" Command="{Binding RefreshCommand}" ToolTip="F5" VerticalAlignment="Top" />
            <StackPanel>
                <ui:TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr Debloat_Title}" />
                <ui:TextBlock Style="{StaticResource PageIntro}" Text="{l:Tr Debloat_PageHint}" />
            </StackPanel>
        </DockPanel>

        <TabControl Grid.Row="1" ItemContainerStyle="{StaticResource SelectorTab}" SelectedIndex="{Binding DebloatTab}">
            <TabItem Header="{l:Tr Debloat_TabStore}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,-16,0">
                    <StackPanel Margin="0,0,16,0">
                        <!-- What is offered and that removing cannot be undone here, in one note -->
                        <ui:InfoBar Title="" Message="{l:Tr Debloat_TabNote}" Severity="Informational" IsOpen="True" IsClosable="False" Margin="0,0,0,8" />
                        <ui:InfoBar Title="" Message="{l:Tr Banner_AdminToApply}" Severity="Warning" IsClosable="False"
                                    IsOpen="{Binding IsElevated, Converter={StaticResource InverseBool}}" Margin="0,0,0,8" />
                        <ui:InfoBar Title="" Message="{Binding Debloat.CameBackText}" Severity="Warning" IsClosable="False" Margin="0,0,0,4"
                                    IsOpen="{Binding Debloat.CameBackText, Converter={StaticResource NullToBool}}" />
                        <ui:Button Content="{l:Tr Debloat_CameBackDismiss}" Command="{Binding Debloat.DismissCameBackCommand}" Margin="0,0,0,8"
                                   Visibility="{Binding Debloat.CameBackText, Converter={StaticResource NullToVisibility}}" />
                        <ui:ProgressRing IsIndeterminate="True" Width="24" Height="24" HorizontalAlignment="Left" Visibility="{Binding Debloat.IsLoading, Converter={StaticResource BoolToVisibility}}" />
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Debloat_Empty}" Visibility="{Binding Debloat.ItemsEmpty, Converter={StaticResource BoolToVisibility}}" />

                        <ItemsControl ItemsSource="{Binding Debloat.Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ui:CardControl Margin="{StaticResource CardRowMargin}" Padding="{StaticResource CardPadding}" IsHitTestVisible="True">
                                        <ui:CardControl.Icon>
                                            <ui:SymbolIcon Symbol="{Binding Symbol}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                        </ui:CardControl.Icon>
                                        <ui:CardControl.Header>
                                            <StackPanel>
                                                <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Name}" />
                                                <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Text}" Margin="0,4,0,0" />
                                                <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,4,0,0" Visibility="{Binding DataContext.ShowTechnical, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
                                                    <Run Text="{Binding Group, Mode=OneWay}" /><Run Text=", " /><Run Text="{Binding PackageName, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding Version, Mode=OneWay}" />
                                                </ui:TextBlock>
                                                <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="{Binding BlockText}" TextWrapping="Wrap"
                                                              Margin="0,4,0,0" Visibility="{Binding BlockText, Converter={StaticResource NullToVisibility}}" />
                                            </StackPanel>
                                        </ui:CardControl.Header>
                                        <ui:Button Content="{l:Tr Debloat_Remove}" Appearance="Secondary" IsEnabled="{Binding CanRemove}" AutomationProperties.Name="{Binding RemoveLabel}"
                                                   Command="{Binding DataContext.Debloat.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </ui:CardControl>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Apps nobody reviewed: off by default, with a warning, in a section of their own after the reviewed list
                             (the switch between the list and OneDrive read as one more app) -->
                        <ui:TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr Debloat_OtherApps}" />
                        <ui:CardControl Padding="{StaticResource CardPadding}">
                            <ui:CardControl.Icon>
                                <ui:SymbolIcon Symbol="Warning24" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <ui:TextBlock FontTypography="Body" Text="{l:Tr Debloat_UnreviewedSwitch}" />
                                    <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Debloat_UnreviewedHint}" Margin="0,4,0,0" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch AutomationProperties.Name="{l:Tr Debloat_UnreviewedSwitch}" IsChecked="{Binding Debloat.ShowUnreviewed}" />
                        </ui:CardControl>
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Debloat_UnreviewedEmpty}" Margin="0,8,0,0"
                                      Visibility="{Binding Debloat.UnreviewedEmpty, Converter={StaticResource BoolToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding Debloat.Unreviewed}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ui:CardControl Margin="{StaticResource CardRowMargin}" Padding="{StaticResource CardPadding}">
                                        <ui:CardControl.Icon>
                                            <ui:SymbolIcon Symbol="Apps24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                        </ui:CardControl.Icon>
                                        <ui:CardControl.Header>
                                            <StackPanel>
                                                <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Name}" TextWrapping="Wrap" />
                                                <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Meta}" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </ui:CardControl.Header>
                                        <ui:Button Content="{l:Tr Debloat_Remove}" Appearance="Secondary" IsEnabled="{Binding CanRemove}"
                                                   Command="{Binding DataContext.Debloat.RemoveUnreviewedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </ui:CardControl>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- OneDrive -->
                        <ui:TextBlock Style="{StaticResource SectionHeader}" Text="OneDrive" />
                        <ui:CardControl Padding="{StaticResource CardPadding}">
                            <ui:CardControl.Icon>
                                <ui:SymbolIcon Symbol="Cloud24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Debloat_OneDriveTitle}" />
                                    <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Debloat.OneDriveText}" Margin="0,4,0,0" />
                                    <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="{Binding Debloat.OneDriveBlock}" TextWrapping="Wrap"
                                                  Margin="0,4,0,0" Visibility="{Binding Debloat.OneDriveBlock, Converter={StaticResource NullToVisibility}}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:Button Content="{l:Tr Debloat_Uninstall}" Appearance="Secondary" IsEnabled="{Binding Debloat.CanUninstallOneDrive}" Command="{Binding Debloat.UninstallOneDriveCommand}"
                                       Visibility="{Binding Debloat.OneDriveInstalled, Converter={StaticResource BoolToVisibility}}" />
                        </ui:CardControl>

                        <!-- Edge: guided only -->
                        <ui:TextBlock Style="{StaticResource SectionHeader}" Text="Microsoft Edge" />
                        <ui:CardControl Padding="{StaticResource CardPadding}">
                            <ui:CardControl.Icon>
                                <ui:SymbolIcon Symbol="Info24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Debloat_EdgeText}" />
                            </ui:CardControl.Header>
                        </ui:CardControl>

                        <!-- Removed apps -->
                        <ui:TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr Debloat_RemovedTitle}" />
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Debloat_RemovedEmpty}" Visibility="{Binding Debloat.RemovedEmpty, Converter={StaticResource BoolToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding Debloat.Removed}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ui:CardControl Margin="{StaticResource CardRowMargin}" Padding="{StaticResource CardPadding}">
                                        <ui:CardControl.Header>
                                            <StackPanel>
                                                <ui:TextBlock FontTypography="Body" Text="{Binding Name}" />
                                                <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding When}" />
                                            </StackPanel>
                                        </ui:CardControl.Header>
                                        <ui:Button Content="{l:Tr Debloat_Reinstall}" Icon="{ui:SymbolIcon Open20}"
                                                   Command="{Binding DataContext.Debloat.OpenStoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding StoreLink}"
                                                   Visibility="{Binding StoreLink, Converter={StaticResource NullToVisibility}}" />
                                    </ui:CardControl>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{l:Tr Programs_Title}">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Programs_Hint}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <DockPanel Margin="0,0,0,8">
                            <ui:TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" Text="{Binding Apps.ProgramsText}" VerticalAlignment="Center" Margin="12,0,0,0" />
                            <ui:TextBox PlaceholderText="{l:Tr Programs_Search}" Icon="{ui:SymbolIcon Search20}" Text="{Binding Apps.ProgramSearch, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
                        </DockPanel>
                    </StackPanel>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Apps.ProgramRows}" Style="{StaticResource VirtualCardList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:CardControl Margin="{StaticResource CardRowMargin}" Padding="{StaticResource CardPadding}">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Name}" TextWrapping="Wrap" />
                                            <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Meta}" Margin="0,4,0,0" />
                                            <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding StateText}" Margin="0,4,0,0" TextWrapping="Wrap"
                                                          Visibility="{Binding StateText, Converter={StaticResource NullToVisibility}}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="0,0,12,0" Visibility="{Binding IsRemoving, Converter={StaticResource BoolToVisibility}}" />
                                        <ui:Button Content="{l:Tr Programs_Uninstall}" Icon="{ui:SymbolIcon Delete20}" IsEnabled="{Binding IsRemoving, Converter={StaticResource InverseBool}}" AutomationProperties.Name="{Binding UninstallLabel}"
                                                   Command="{Binding DataContext.Apps.UninstallProgramCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                </ui:CardControl>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
