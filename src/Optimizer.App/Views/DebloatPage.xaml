<UserControl x:Class="Optimizer.App.Views.DebloatPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:Optimizer.App.Services"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource PagePadding}">
            <DockPanel>
                <ui:Button DockPanel.Dock="Right" Content="{l:Tr Common_Refresh}" Icon="{ui:SymbolIcon ArrowSync20}" Command="{Binding Debloat.ReloadCommand}" VerticalAlignment="Top" />
                <StackPanel>
                    <ui:TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr Debloat_Title}" />
                    <ui:TextBlock Style="{StaticResource PageIntro}" Text="{l:Tr Debloat_Hint}" />
                </StackPanel>
            </DockPanel>
            <ui:InfoBar Title="" Message="{l:Tr Debloat_NotUndoable}" Severity="Informational" IsOpen="True" IsClosable="False" Margin="0,0,0,8" />
            <ui:InfoBar Title="" Message="{Binding Debloat.CameBackText}" Severity="Warning" IsClosable="False" Margin="0,0,0,4"
                        IsOpen="{Binding Debloat.CameBackText, Converter={StaticResource NullToBool}}" />
            <ui:Button Content="{l:Tr Debloat_CameBackDismiss}" Command="{Binding Debloat.DismissCameBackCommand}" Margin="0,0,0,8"
                       Visibility="{Binding Debloat.CameBackText, Converter={StaticResource NullToVisibility}}" />
            <ui:ProgressRing IsIndeterminate="True" Width="24" Height="24" HorizontalAlignment="Left" Visibility="{Binding Debloat.IsLoading, Converter={StaticResource BoolToVisibility}}" />
            <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Debloat_Empty}" Visibility="{Binding Debloat.ItemsEmpty, Converter={StaticResource BoolToVisibility}}" />

            <ItemsControl ItemsSource="{Binding Debloat.Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:CardControl Margin="{StaticResource CardRowMargin}" Padding="{StaticResource CardPadding}" IsHitTestVisible="True">
                            <ui:CardControl.Icon>
                                <ui:SymbolIcon Symbol="Apps24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Name}" />
                                    <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Text}" Margin="0,4,0,0" />
                                    <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,4,0,0">
                                        <Run Text="{Binding Group, Mode=OneWay}" /><Run Text=", " /><Run Text="{Binding PackageName, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding Version, Mode=OneWay}" />
                                    </ui:TextBlock>
                                    <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="{Binding BlockText}" TextWrapping="Wrap"
                                                  Margin="0,4,0,0" Visibility="{Binding BlockText, Converter={StaticResource NullToVisibility}}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:Button Content="{l:Tr Debloat_Remove}" Appearance="Secondary" IsEnabled="{Binding CanRemove}"
                                       Command="{Binding DataContext.Debloat.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                        </ui:CardControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- OneDrive -->
            <ui:TextBlock Style="{StaticResource SectionHeader}" Text="OneDrive" />
            <ui:CardControl Padding="{StaticResource CardPadding}">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="Cloud24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Debloat_OneDriveTitle}" />
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Debloat.OneDriveText}" Margin="0,4,0,0" />
                        <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="{Binding Debloat.OneDriveBlock}" TextWrapping="Wrap"
                                      Margin="0,4,0,0" Visibility="{Binding Debloat.OneDriveBlock, Converter={StaticResource NullToVisibility}}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Content="{l:Tr Debloat_Uninstall}" Appearance="Secondary" IsEnabled="{Binding Debloat.CanUninstallOneDrive}" Command="{Binding Debloat.UninstallOneDriveCommand}" />
            </ui:CardControl>

            <!-- Edge: guided only -->
            <ui:TextBlock Style="{StaticResource SectionHeader}" Text="Microsoft Edge" />
            <ui:Card Padding="16,12">
                <ui:TextBlock FontTypography="Body" Text="{l:Tr Debloat_EdgeText}" TextWrapping="Wrap" />
            </ui:Card>

            <!-- Removed apps -->
            <ui:TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr Debloat_RemovedTitle}" />
            <ui:TextBlock Style="{StaticResource Caption}" Text="{l:Tr Debloat_RemovedEmpty}" Visibility="{Binding Debloat.RemovedEmpty, Converter={StaticResource BoolToVisibility}}" />
            <ItemsControl ItemsSource="{Binding Debloat.Removed}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:CardControl Margin="{StaticResource CardRowMargin}" Padding="{StaticResource CardPadding}">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <ui:TextBlock FontTypography="Body" Text="{Binding Name}" />
                                    <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding When}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:Button Content="{l:Tr Debloat_Reinstall}" Icon="{ui:SymbolIcon Open20}"
                                       Command="{Binding DataContext.Debloat.OpenStoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding StoreLink}"
                                       Visibility="{Binding StoreLink, Converter={StaticResource NullToVisibility}}" />
                        </ui:CardControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
