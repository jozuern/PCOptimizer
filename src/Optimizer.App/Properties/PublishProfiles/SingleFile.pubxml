<?xml version="1.0" encoding="utf-8"?>
<!-- Single self-contained exe. dotnet publish src/Optimizer.App -p:PublishProfile=SingleFile -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- The single-file analyzer would add Microsoft.NET.ILLink.Tasks (its version follows the SDK) to the publish
         restore only: the build's packages.lock.json would not match, and CI's locked restore would fail. Off, the
         publish restores exactly what the build restores, in locked mode. -->
    <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <PublishDir>..\..\artifacts\publish\</PublishDir>
  </PropertyGroup>
</Project>
