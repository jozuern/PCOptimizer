{
  "tweaks": [
    {
      "id": "network.throttlingIndex",
      "category": "Network",
      "impact": {
        "gaming": 0,
        "basis": "disputed",
        "effect": [
          "none"
        ]
      },
      "risk": "safe",
      "restart": true,
      "actions": [
        {
          "type": "registry",
          "hive": "machine",
          "path": "SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Multimedia\\SystemProfile",
          "name": "NetworkThrottlingIndex",
          "kind": "dword",
          "value": "0xFFFFFFFF"
        }
      ],
      "sources": [
        "https://learn.microsoft.com/en-us/archive/blogs/markrussinovich/vista-multimedia-playback-and-network-throughput",
        "https://support.tibco.com/s/article/Tibco-KnowledgeArticle-Article-38041",
        "https://learn.microsoft.com/en-us/windows/win32/procthread/multimedia-class-scheduler-service"
      ]
    },
    {
      "id": "network.nagleOff",
      "category": "Network",
      "impact": {
        "gaming": 0,
        "basis": "disputed",
        "effect": [
          "latency"
        ]
      },
      "risk": "moderate",
      "actions": [
        {
          "type": "registry",
          "hive": "machine",
          "path": "SYSTEM\\CurrentControlSet\\Services\\Tcpip\\Parameters\\Interfaces\\{nic}",
          "name": "TcpAckFrequency",
          "kind": "dword",
          "value": 1
        }
      ],
      "sources": [
        "https://learn.microsoft.com/en-us/troubleshoot/windows-server/networking/registry-entry-control-tcp-acknowledgment-behavior",
        "https://www.rfc-editor.org/rfc/rfc896",
        "https://learn.microsoft.com/en-us/windows/win32/winsock/ipproto-tcp-socket-options"
      ]
    },
    {
      "id": "network.deliveryOptimizationP2POff",
      "category": "Network",
      "impact": {
        "gaming": 0,
        "basis": "situational",
        "effect": [
          "latency"
        ]
      },
      "risk": "safe",
      "actions": [
        {
          "type": "registry",
          "hive": "machine",
          "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\DeliveryOptimization",
          "name": "DODownloadMode",
          "kind": "dword",
          "value": 0
        }
      ],
      "sources": [
        "https://learn.microsoft.com/en-us/windows/deployment/do/waas-delivery-optimization-reference",
        "https://learn.microsoft.com/en-us/windows/client-management/mdm/policy-csp-deliveryoptimization"
      ]
    },
    {
      "id": "network.preferIpv4",
      "category": "Network",
      "impact": {
        "gaming": 0,
        "basis": "situational",
        "effect": [
          "none"
        ]
      },
      "risk": "safe",
      "restart": true,
      "actions": [
        {
          "type": "registryBits",
          "hive": "machine",
          "path": "SYSTEM\\CurrentControlSet\\Services\\Tcpip6\\Parameters",
          "name": "DisabledComponents",
          "set": 32
        }
      ],
      "sources": [
        "https://learn.microsoft.com/en-us/troubleshoot/windows-server/networking/configure-ipv6-in-windows"
      ]
    }
  ]
}
