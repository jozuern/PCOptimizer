{
  "tweaks": [
    {
      "id": "security.vbsOff",
      "category": "Expert",
      "impact": {
        "gaming": 2,
        "basis": "situational",
        "effect": [
          "fps",
          "lows"
        ]
      },
      "impactOverrides": [
        {
          "when": {
            "fact": "vbs.running",
            "eq": false
          },
          "gaming": 0,
          "reasonKey": "impact.vbsAlreadyOff"
        },
        {
          "when": {
            "fact": "cpu.mbec",
            "eq": false
          },
          "gaming": 3,
          "reasonKey": "impact.noMbec"
        }
      ],
      "risk": "expert",
      "preview": true,
      "bootCritical": true,
      "antiCheatSensitive": true,
      "restart": true,
      "verify": "afterRestart",
      "actions": [
        {
          "type": "registry",
          "hive": "machine",
          "path": "SYSTEM\\CurrentControlSet\\Control\\DeviceGuard",
          "name": "EnableVirtualizationBasedSecurity",
          "kind": "dword",
          "value": 0
        },
        {
          "type": "registry",
          "hive": "machine",
          "path": "SYSTEM\\CurrentControlSet\\Control\\DeviceGuard\\Scenarios\\HypervisorEnforcedCodeIntegrity",
          "name": "Enabled",
          "kind": "dword",
          "value": 0
        }
      ],
      "sources": [
        "https://learn.microsoft.com/en-us/windows/security/hardware-security/enable-virtualization-based-protection-of-code-integrity",
        "https://learn.microsoft.com/en-us/windows/security/identity-protection/credential-guard/",
        "https://www.tomshardware.com/news/windows-11-gaming-benchmarks-performance-vbs-hvci-security",
        "https://support.faceit.com/hc/en-us/articles/23117181142556-Windows-Security-Requirements-FAQ",
        "https://support.riotgames.com/riot/performance/vanguard-security-requirements",
        "https://support.faceit.com/hc/en-us/articles/8546882512284-Enabling-Memory-Integrity-HVCI"
      ]
    }
  ]
}
