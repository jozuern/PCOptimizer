{
  "tweaks": [
    {
      "id": "battery.boostOffDc",
      "category": "Battery",
      "impact": {
        "gaming": 0,
        "basis": "situational",
        "effect": [
          "none"
        ]
      },
      "risk": "moderate",
      "appliesTo": {
        "formFactor": "laptop"
      },
      "conflictsWith": [
        "quiet.boostOff"
      ],
      "actions": [
        {
          "type": "powerSetting",
          "subgroup": "SUB_PROCESSOR",
          "setting": "PERFBOOSTMODE",
          "dc": 0
        }
      ],
      "sources": [
        "https://learn.microsoft.com/en-us/windows-hardware/customize/power-settings/options-for-perf-state-engine-perfboostmode",
        "https://learn.microsoft.com/en-us/windows-hardware/customize/power-settings/configure-processor-power-management-options"
      ]
    },
    {
      "id": "battery.wifiPowerSavingDc",
      "category": "Battery",
      "impact": {
        "gaming": 0,
        "basis": "situational",
        "effect": [
          "none"
        ]
      },
      "risk": "safe",
      "appliesTo": {
        "formFactor": "laptop"
      },
      "actions": [
        {
          "type": "powerSetting",
          "subgroup": "SUB_WIRELESS",
          "setting": "WIRELESSPOWERSAVE",
          "dc": 3
        }
      ],
      "sources": [
        "https://learn.microsoft.com/en-us/archive/blogs/richardsmith/powercfg-useful-if-you-know-the-guids",
        "https://learn.microsoft.com/en-us/windows-hardware/design/device-experiences/powercfg-command-line-options"
      ]
    },
    {
      "id": "battery.pcieAspmMaxDc",
      "category": "Battery",
      "impact": {
        "gaming": 0,
        "basis": "measured",
        "effect": [
          "none"
        ]
      },
      "risk": "safe",
      "appliesTo": {
        "formFactor": "laptop"
      },
      "actions": [
        {
          "type": "powerSetting",
          "subgroup": "SUB_PCIEXPRESS",
          "setting": "ASPM",
