{
  "tweaks": [
    {
      "id": "focus.startAccountNotificationsOff",
      "category": "Focus",
      "impact": {
        "gaming": 0,
        "basis": "situational",
        "effect": [
          "none"
        ]
      },
      "risk": "safe",
      "scope": "user",
      "appliesTo": {
        "when": {
          "not": {
            "fact": "os.edition",
            "in": [
              "Core",
              "CoreN",
              "CoreSingleLanguage",
              "CoreCountrySpecific"
            ]
          }
        }
      },
      "actions": [
        {
          "type": "registry",
          "hive": "user",
          "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\CurrentVersion\\AccountNotifications",
          "name": "DisableAccountNotifications",
          "kind": "dword",
          "value": 1
        }
      ],
      "sources": [
        "https://learn.microsoft.com/en-us/windows/client-management/mdm/policy-csp-notifications"
      ]
    },
    {
      "id": "focus.altTabTabsOff",
      "category": "Focus",
      "impact": {
        "gaming": 0,
        "basis": "situational",
        "effect": [
          "none"
        ]
      },
      "risk": "safe",
      "proof": [ "docs/vm-test-results-2026-10-11.md: Settings > Multitasking showed \"Show tabs from apps when snapping or pressing Alt+Tab\" as \"Don't show tabs\", locked by the policy, after apply and \"3 most recent tabs\" after undo" ],
      "scope": "user",
      "appliesTo": {
        "when": {
          "not": {
            "fact": "os.edition",
            "in": [
              "Core",
              "CoreN",
              "CoreSingleLanguage",
              "CoreCountrySpecific"
            ]
          }
        }
      },
      "actions": [
        {
          "type": "registry",
          "hive": "user",
          "path": "Software\\Policies\\Microsoft\\Windows\\Explorer",
          "name": "MultiTaskingAltTabFilter",
          "kind": "dword",
          "value": 4
        }
      ],
      "sources": [
        "https://learn.microsoft.com/en-us/windows/client-management/mdm/policy-csp-multitasking"
      ]
    },
    {
      "id": "privacy.searchHistoryOff",
      "undocumented": true,
      "category": "Privacy",
      "impact": {
        "gaming": 0,
        "basis": "situational",
        "effect": [
          "none"
        ]
      },
      "risk": "safe",
      "proof": [ "docs/vm-test-results-2026-10-11.md: Settings > Search permissions showed \"Search history on this device\" Off after apply and On after undo" ],
      "scope": "user",
      "actions": [
        {
          "type": "registry",
          "hive": "user",
          "path": "Software\\Microsoft\\Windows\\CurrentVersion\\SearchSettings",
          "name": "IsDeviceSearchHistoryEnabled",
          "kind": "dword",
          "value": 0,
          "notify": "settings"
        }
      ],
      "sources": [
        "https://support.microsoft.com/en-us/windows/privacy/windows-search-and-privacy",
        "https://www.elevenforum.com/t/enable-or-disable-recent-search-history-in-windows-11.5395/"
      ]
    },
    {
      "id": "input.printScreenSnippingOff",
      "undocumented": true,
      "category": "Input",
      "impact": {
        "gaming": 0,
        "basis": "situational",
        "effect": [
          "none"
        ]
      },
      "risk": "safe",
      "proof": [ "docs/vm-test-results-2026-10-11.md: after signing in again the Print Screen key no longer opened the Snipping Tool; it did before apply and after undo and signing in" ],
      "signOut": true,
      "scope": "user",
      "actions": [
        {
          "type": "registry",
          "hive": "user",
          "path": "Control Panel\\Keyboard",
          "name": "PrintScreenKeyForSnippingEnabled",
          "kind": "dword",
          "value": 0,
          "notify": "settings"
        }
      ],
      "sources": [
        "https://www.elevenforum.com/t/enable-or-disable-use-print-screen-key-to-open-screen-snipping-in-windows-11.520/"
      ]
    },
    {
