{
  "tweaks": [
    {
      "id": "gpu.hags",
      "category": "Graphics",
      "impact": {
        "gaming": 0,
        "basis": "situational",
        "effect": [
          "none"
        ]
      },
      "impactOverrides": [
        {
          "when": {
            "fact": "gpu.supportsFrameGeneration",
            "eq": true
          },
          "gaming": 3,
          "effect": [
            "prerequisite"
          ],
          "reasonKey": "impact.hagsFrameGen"
        }
      ],
      "risk": "safe",
      "restart": true,
      "verify": "afterRestart",
      "appliesTo": {
        "when": {
          "fact": "gpu.supportsHags",
          "eq": true
        }
      },
      "actions": [
        {
          "type": "registry",
          "hive": "machine",
          "path": "SYSTEM\\CurrentControlSet\\Control\\GraphicsDrivers",
          "name": "HwSchMode",
          "kind": "dword",
          "value": 2
        }
      ],
      "recommendWhen": {
        "fact": "gpu.supportsFrameGeneration",
        "eq": true
      },
      "sources": [
        "https://devblogs.microsoft.com/directx/hardware-accelerated-gpu-scheduling/",
        "https://github.com/NVIDIA-RTX/Streamline/blob/main/docs/ProgrammingGuideDLSS_G.md",
        "https://www.intel.com/content/www/us/en/support/articles/000056788/graphics.html"
      ],
      "recommendReasonKey": "rec.frameGeneration"
    },
    {
      "id": "gpu.windowedOptimizations",
      "category": "Graphics",
      "impact": {
        "gaming": 1,
        "basis": "situational",
        "effect": [
          "latency"
        ]
      },
      "risk": "safe",
      "scope": "user",
      "appliesTo": {
        "when": {
          "fact": "gpu.hasDiscrete",
          "eq": true
        }
      },
      "actions": [
        {
          "type": "registryToken",
          "hive": "user",
          "path": "Software\\Microsoft\\DirectX\\UserGpuPreferences",
          "name": "DirectXUserGlobalSettings",
          "token": "SwapEffectUpgradeEnable",
          "value": "1"
        }
      ],
      "recommendWhen": {
        "all": [
          {
            "fact": "gpu.hasDiscrete",
            "eq": true
          },
          {
            "fact": "display.autoHdr",
            "eq": false
          }
        ]
      },
      "sources": [
        "https://devblogs.microsoft.com/directx/updates-in-graphics-and-gaming/",
        "https://support.microsoft.com/en-us/topic/3f006843-2c7e-4ed0-9a5e-f9389e535952"
      ],
      "recommendReasonKey": "rec.windowedFlip"
    },
    {
      "id": "gpu.gameMode",
      "category": "Graphics",
      "impact": {
        "gaming": 1,
        "basis": "situational",
        "effect": [
          "stutter"
        ]
      },
      "risk": "safe",
      "scope": "user",
      "actions": [
        {
          "type": "registry",
          "hive": "user",
          "path": "Software\\Microsoft\\GameBar",
          "name": "AutoGameModeEnabled",
          "kind": "dword",
          "value": 1,
          "missingMeans": 1
        },
        {
          "type": "registry",
          "hive": "user",
          "path": "Software\\Microsoft\\GameBar",
          "name": "AllowAutoGameMode",
          "kind": "dword",
          "value": 1,
          "missingMeans": 1
        }
      ],
      "recommendWhen": {
        "fact": "os.build",
        "gte": 26100
      },
      "sources": [
        "https://news.xbox.com/en-us/2018/10/02/latest-october-2018-windows-update-gaming-features-3/",
        "https://learn.microsoft.com/en-us/previous-versions/windows/desktop/gamemode/game-mode-portal"
      ],
      "recommendReasonKey": "rec.gameModeOff"
    },
    {
      "id": "gpu.gameDvrOff",
      "category": "Graphics",
      "impact": {
        "gaming": 0,
        "basis": "situational",
        "effect": [
          "none"
        ]
      },
      "impactOverrides": [
        {
          "when": {
            "fact": "gamedvr.backgroundRecording",
            "eq": true
          },
          "gaming": 1,
          "effect": [
            "stutter"
          ],
          "reasonKey": "impact.backgroundRecording"
        }
      ],
      "risk": "safe",
      "scope": "user",
      "actions": [
        {
          "type": "registry",
          "hive": "user",
          "path": "System\\GameConfigStore",
          "name": "GameDVR_Enabled",
          "kind": "dword",
          "value": 0
        },
        {
          "type": "registry",
          "hive": "user",
          "path": "Software\\Microsoft\\Windows\\CurrentVersion\\GameDVR",
          "name": "AppCaptureEnabled",
          "kind": "dword",
          "value": 0
        },
        {
          "type": "registry",
          "hive": "user",
          "path": "Software\\Microsoft\\Windows\\CurrentVersion\\GameDVR",
          "name": "HistoricalCaptureEnabled",
          "kind": "dword",
          "value": 0,
          "missingMeans": 0
        }
      ],
      "recommendWhen": {
        "fact": "gamedvr.backgroundRecording",
        "eq": true
      },
      "sources": [
        "https://learn.microsoft.com/en-us/windows/client-management/mdm/policy-csp-applicationmanagement",
        "https://github.com/ChrisTitusTech/winutil"
      ],
      "recommendReasonKey": "rec.backgroundRecording"
    },
    {
      "id": "gpu.mpoOff",
      "category": "Graphics",
      "impact": {
        "gaming": 0,
        "basis": "situational",
        "effect": [
          "stability"
        ]
      },
      "risk": "moderate",
      "preview": true,
      "restart": true,
      "verify": "afterRestart",
      "actions": [
        {
          "type": "registry",
          "hive": "machine",
          "path": "SOFTWARE\\Microsoft\\Windows\\Dwm",
          "name": "OverlayTestMode",
          "kind": "dword",
          "value": 5
        }
      ],
      "sources": [
        "https://nvidia.custhelp.com/app/answers/detail/a_id/5157"
      ]
    }
  ]
}
