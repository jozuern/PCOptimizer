{
  "tweaks": [
    {
      "id": "gpu.hags",
      "category": "Graphics",
      "impact": {
        "gaming": 1,
        "basis": "situational",
        "effect": [
          "latency"
        ]
      },
      "impactOverrides": [
        {
          "when": {
            "fact": "gpu.supportsFrameGeneration",
            "eq": true
          },
          "gaming": 3,
          "effect": [
            "prerequisite"
          ],
          "reasonKey": "impact.hagsFrameGen"
        }
      ],
      "risk": "safe",
      "restart": true,
      "verify": "afterRestart",
      "appliesTo": {
        "when": {
          "fact": "gpu.supportsHags",
          "eq": true
        }
      },
      "actions": [
        {
          "type": "registry",
          "hive": "machine",
          "path": "SYSTEM\\CurrentControlSet\\Control\\GraphicsDrivers",
          "name": "HwSchMode",
          "kind": "dword",
          "value": 2
        }
      ],
      "recommendWhen": {
        "fact": "gpu.supportsFrameGeneration",
        "eq": true
      },
      "sources": [
        "https://devblogs.microsoft.com/directx/hardware-accelerated-gpu-scheduling/"
      ],
      "recommendReasonKey": "rec.frameGeneration"
    },
    {
      "id": "gpu.windowedOptimizations",
      "category": "Graphics",
      "impact": {
        "gaming": 1,
        "basis": "situational",
        "effect": [
          "latency"
        ]
      },
      "risk": "safe",
      "scope": "user",
      "appliesTo": {
        "when": {
          "fact": "gpu.hasDiscrete",
          "eq": true
        }
      },
      "actions": [
        {
          "type": "registryToken",
          "hive": "user",
          "path": "Software\\Microsoft\\DirectX\\UserGpuPreferences",
          "name": "DirectXUserGlobalSettings",
          "token": "SwapEffectUpgradeEnable",
          "value": "1"
        }
      ],
      "recommendWhen": {
        "all": [
          {
            "fact": "gpu.hasDiscrete",
            "eq": true
          },
          {
            "fact": "display.autoHdr",
            "eq": false
          }
        ]
      },
      "sources": [
        "https://devblogs.microsoft.com/directx/optimizations-for-windowed-games-in-windows-11/",
        "https://support.microsoft.com/en-us/topic/3f006843-2c7e-4ed0-9a5e-f9389e535952"
      ],
      "recommendReasonKey": "rec.windowedFlip"
    },
    {
      "id": "gpu.gameMode",
      "category": "Graphics",
      "impact": {
        "gaming": 1,
        "basis": "situational",
        "effect": [
          "stutter"
        ]
      },
      "risk": "safe",
      "scope": "user",
      "actions": [
        {
          "type": "registry",
          "hive": "user",
          "path": "Software\\Microsoft\\GameBar",
          "name": "AutoGameModeEnabled",
          "kind": "dword",
          "value": 1,
          "missingMeans": 1
        },
        {
          "type": "registry",
          "hive": "user",
          "path": "Software\\Microsoft\\GameBar",
          "name": "AllowAutoGameMode",
          "kind": "dword",
          "value": 1,
          "missingMeans": 1
        }
      ],
      "recommendWhen": {
        "fact": "os.build",
        "gte": 26100
      },
      "sources": [
        "https://www.elevenforum.com/t/turn-on-or-off-game-mode-in-windows-11.1447/"
      ],
      "recommendReasonKey": "rec.gameModeOff"
    },
    {
