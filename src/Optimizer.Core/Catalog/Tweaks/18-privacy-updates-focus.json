{
  "tweaks": [
    {
      "id": "privacy.locationServiceOff",
      "category": "Privacy",
      "impact": {
        "gaming": 0,
        "basis": "situational",
        "effect": [
          "none"
        ]
      },
      "risk": "safe",
      "appliesTo": {
        "when": {
          "not": {
            "fact": "os.edition",
            "in": [
              "Core",
              "CoreN",
              "CoreSingleLanguage",
              "CoreCountrySpecific"
            ]
          }
        }
      },
      "actions": [
        {
          "type": "registry",
          "hive": "machine",
          "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\LocationAndSensors",
          "name": "DisableLocation",
          "kind": "dword",
          "value": 1
        }
      ],
      "sources": [
        "https://learn.microsoft.com/en-us/windows/client-management/mdm/policy-csp-system",
        "https://learn.microsoft.com/en-us/windows/privacy/manage-connections-from-windows-operating-system-components-to-microsoft-services"
      ]
    },
