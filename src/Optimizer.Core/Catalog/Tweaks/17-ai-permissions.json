{
  "tweaks": [
    {
      "id": "ai.recallOff",
      "category": "AI",
      "impact": {
        "gaming": 0,
        "basis": "situational",
        "effect": [
          "none"
        ]
      },
      "risk": "moderate",
      "reversibility": "permanent",
      "restart": true,
      "appliesTo": {
        "when": {
          "not": {
            "fact": "os.edition",
            "in": [
              "Core",
              "CoreN",
              "CoreSingleLanguage",
              "CoreCountrySpecific"
            ]
          }
        }
      },
      "actions": [
        {
          "type": "registry",
          "hive": "machine",
          "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsAI",
          "name": "AllowRecallEnablement",
          "kind": "dword",
          "value": 0
        }
      ],
      "sources": [
        "https://learn.microsoft.com/en-us/windows/client-management/mdm/policy-csp-windowsai"
      ]
    },
