{
  "_comment": "Windows Update, device installation and recovery settings. All documented by Microsoft (Policy CSP or support article).",
  "tweaks": [
    {
      "id": "updates.driversExcluded",
      "category": "System",
      "impact": {
        "gaming": 0,
        "basis": "situational",
        "effect": [
          "stability"
        ]
      },
      "risk": "moderate",
      "appliesTo": {
        "when": {
          "not": {
            "fact": "os.edition",
            "in": [
              "Core",
              "CoreN",
              "CoreSingleLanguage",
              "CoreCountrySpecific"
            ]
          }
        }
      },
      "actions": [
        {
          "type": "registry",
          "hive": "machine",
          "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate",
          "name": "ExcludeWUDriversInQualityUpdate",
          "kind": "dword",
          "value": 1
        }
      ],
      "sources": [
        "https://learn.microsoft.com/en-us/windows/client-management/mdm/policy-csp-update"
      ]
    },
    {
      "id": "privacy.deviceMetadataOff",
      "category": "Privacy",
      "impact": {
        "gaming": 0,
        "basis": "situational",
        "effect": [
          "none"
        ]
      },
      "risk": "safe",
      "appliesTo": {
        "when": {
          "not": {
            "fact": "os.edition",
            "in": [
              "Core",
              "CoreN",
              "CoreSingleLanguage",
              "CoreCountrySpecific"
            ]
          }
        }
      },
      "actions": [
        {
          "type": "registry",
          "hive": "machine",
          "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\Device Metadata",
          "name": "PreventDeviceMetadataFromNetwork",
          "kind": "dword",
          "value": 1
        }
      ],
      "sources": [
        "https://learn.microsoft.com/en-us/windows/client-management/mdm/policy-csp-deviceinstallation"
      ]
    },
    {
      "id": "system.registryBackup",
      "category": "System",
      "impact": {
        "gaming": 0,
        "basis": "situational",
        "effect": [
          "none"
        ]
      },
      "risk": "safe",
      "restart": true,
      "verify": "afterRestart",
      "actions": [
        {
          "type": "registry",
          "hive": "machine",
          "path": "SYSTEM\\CurrentControlSet\\Control\\Session Manager\\Configuration Manager",
          "name": "EnablePeriodicBackup",
          "kind": "dword",
          "value": 1
        }
      ],
      "sources": [
        "https://learn.microsoft.com/en-us/troubleshoot/windows-client/installing-updates-features-roles/system-registry-no-backed-up-regback-folder"
      ]
    }
  ]
}
