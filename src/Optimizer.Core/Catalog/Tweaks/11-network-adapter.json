    {
      "id": "network.nicPowerSavingOff",
      "category": "Network",
      "impact": {
        "gaming": 1,
        "basis": "situational",
        "effect": [
          "stability"
        ]
      },
      "risk": "moderate",
      "preview": true,
      "actions": [
        {
          "type": "nicProperty",
          "media": "ethernet",
          "properties": {
            "*EEE": "0",
            "*SelectiveSuspend": "0"
          }
        }
      ],
      "sources": [
        "https://learn.microsoft.com/en-us/windows-hardware/drivers/network/standardized-inf-keywords-for-power-management",
        "https://edc.intel.com/content/www/us/en/design/products/ethernet/adapters-and-devices-user-guide/other-power-options",
        "https://learn.microsoft.com/en-us/windows-hardware/drivers/network/standardized-inf-keywords-for-ndis-selective-suspend",
        "https://www.asus.com/support/faq/1052466"
      ]
    },
