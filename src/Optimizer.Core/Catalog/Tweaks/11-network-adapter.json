{
  "tweaks": [
    {
      "id": "network.nicPowerSavingOff",
      "category": "Network",
      "impact": {
        "gaming": 1,
        "basis": "situational",
        "effect": [
          "latency"
        ]
      },
      "risk": "moderate",
      "actions": [
        {
          "type": "nicProperty",
          "media": "ethernet",
          "properties": {
            "*EEE": "0",
            "EEELinkAdvertisement": "0",
            "EEE": "0",
            "AdvancedEEE": "0",
            "GreenEthernet": "0",
            "PowerSavingMode": "0",
            "AutoPowerSaveModeEnabled": "0",
            "SipsEnabled": "0",
            "ULPMode": "0",
            "*SelectiveSuspend": "0"
          }
        }
      ],
      "sources": [
        "https://learn.microsoft.com/en-us/windows-hardware/drivers/network/enumeration-keywords",
        "https://learn.microsoft.com/en-us/windows-hardware/drivers/network/standardized-inf-keywords-for-power-management"
      ]
    },
    {
