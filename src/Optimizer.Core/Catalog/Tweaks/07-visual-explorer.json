{
  "tweaks": [
    {
      "id": "visual.bestPerformance",
      "category": "Visual",
      "impact": {
        "gaming": 0,
        "basis": "situational",
        "effect": [
          "none"
        ]
      },
      "impactOverrides": [
        {
          "when": {
            "fact": "gpu.hasDiscrete",
            "eq": false
          },
          "gaming": 1,
          "effect": [
            "fps"
          ],
          "reasonKey": "impact.integratedGraphics"
        }
      ],
      "risk": "safe",
      "scope": "user",
      "signOut": true,
      "actions": [
        {
          "type": "registry",
          "hive": "user",
          "path": "Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\VisualEffects",
          "name": "VisualFXSetting",
          "kind": "dword",
          "value": 3
        },
        {
          "type": "registryBinaryBits",
          "hive": "user",
          "path": "Control Panel\\Desktop",
          "name": "UserPreferencesMask",
          "clear": "0E2C040002000000"
        },
        {
          "type": "registry",
          "hive": "user",
          "path": "Control Panel\\Desktop\\WindowMetrics",
          "name": "MinAnimate",
          "kind": "string",
          "value": "0"
        },
        {
          "type": "registry",
          "hive": "user",
          "path": "Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
          "name": "TaskbarAnimations",
          "kind": "dword",
          "value": 0
        },
        {
          "type": "registry",
          "hive": "user",
          "path": "Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
          "name": "ListviewAlphaSelect",
          "kind": "dword",
          "value": 0
        },
        {
          "type": "registry",
          "hive": "user",
          "path": "Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
          "name": "ListviewShadow",
          "kind": "dword",
          "value": 0
        },
        {
          "type": "registry",
          "hive": "user",
          "path": "Control Panel\\Desktop",
          "name": "DragFullWindows",
          "kind": "string",
          "value": "0"
        },
        {
          "type": "registry",
          "hive": "user",
          "path": "Software\\Microsoft\\Windows\\DWM",
          "name": "EnableAeroPeek",
          "kind": "dword",
          "value": 0
        }
      ],
      "sources": [
        "https://support.microsoft.com/en-us/windows/tips-to-improve-pc-performance-in-windows-b3b3ef5b-5953-fb6a-2528-4bbed82fba96",
        "https://learn.microsoft.com/en-us/previous-versions/windows/it-pro/windows-2000-server/cc957204(v=technet.10)"
      ],
      "recommendReasonKey": "rec.integratedGraphics",
      "recommendWhen": {
        "fact": "gpu.hasDiscrete",
        "eq": false
      }
    },
