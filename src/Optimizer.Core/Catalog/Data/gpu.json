{
  "_comment": "GPU catalog data (model lists are catalog data, not code). First matching rule wins. Intel: Arc A and B cards and Arc Pro cards are discrete; Arc B3x0 (B370, B390) is the processor graphics of Core Ultra series 3 (Panther Lake) and stays integrated. ReBAR: NVIDIA rules need GeForce (Turing Quadro RTX cards have no ReBAR); workstation RTX cards fall to Unknown (no advice). AMD RX 5000: compatible per AMD claim GD-178.",
  "pciVendors": { "10DE": "nvidia", "1002": "amd", "1022": "amd", "8086": "intel", "1414": "microsoft", "5143": "qualcomm" },
  "discretePatterns": {
    "nvidia": ".*",
    "amd": "\\bRX\\s?\\d|Radeon\\s+(Pro|VII)|FirePro|Instinct",
    "intel": "Arc(\\(TM\\))?\\s+(Pro\\s+)?(A\\d{2,3}|B\\d{2}\\b|B[4-9]\\d{2})|Iris(\\(R\\))?\\s+Xe\\s+MAX"
  },
  "virtualPatterns": [ "Parsec", "Virtual Display", "Remote Display", "Meta Virtual", "IddSample", "Hyper-V", "VMware", "VirtualBox", "Citrix", "Spacedesk", "Sunshine" ],
  "basicPatterns": [ "Microsoft Basic Display Adapter", "Microsoft Basic Render Driver" ],
  "onCardSwitchVendors": [ "1002", "8086" ],
  "rebar": [
    { "vendor": "nvidia", "regex": "GeForce\\s+RTX\\s*(30|40|50)\\d{2}", "supported": true },
    { "vendor": "nvidia", "regex": "GeForce\\s+RTX\\s*20\\d{2}|GeForce\\s+GTX|TITAN\\s+(RTX|V|X)|Quadro", "supported": false },
    { "vendor": "amd", "regex": "RX\\s*(5|6|7|9)\\d{3}", "supported": true },
    { "vendor": "amd", "regex": "RX\\s*(4|5)\\d{2}\\b|Vega", "supported": false },
    { "vendor": "intel", "regex": "Arc(\\(TM\\))?\\s+(Pro\\s+)?[AB]\\d{2,3}", "supported": true, "critical": true }
  ],
  "sources": [
    "https://www.nvidia.com/en-us/geforce/news/geforce-rtx-30-series-resizable-bar-support/",
    "https://www.nvidia.com/en-us/geforce/graphics-cards/compare/",
    "https://nvidia.custhelp.com/app/answers/detail/a_id/5165/~/nvidia-resizable-bar-firmware-update-tool",
    "https://www.amd.com/en/legal/claims/gaming-details.html",
    "https://game.intel.com/stories/intel-arc-graphics-resizable-bar/",
    "https://www.intel.com/content/www/us/en/support/articles/000090831/graphics.html",
    "https://www.intel.com/content/www/us/en/products/sku/245526/intel-core-ultra-x9-processor-388h-18m-cache-up-to-5-10-ghz/specifications.html",
    "https://learn.microsoft.com/en-us/windows-hardware/drivers/display/resizable-bar-support"
  ]
}
