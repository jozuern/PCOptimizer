<?xml version="1.0" encoding="utf-8"?>
<!-- Packages come only from nuget.org; the lock files (packages.lock.json) pin every version and hash. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
