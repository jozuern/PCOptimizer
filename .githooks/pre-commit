#!/bin/sh
# Raises the patch version in src/Optimizer.App/Optimizer.App.csproj on every commit (0.3.0 -> 0.3.1).
# Enable once per clone:  git config core.hooksPath .githooks
# A version changed by hand in the same commit (for example 0.4.0) is kept.
# Skip for one commit (for example with --amend, where the amended commit already raised it):
#   SKIP_VERSION_BUMP=1 git commit --amend ...
# Merges and rebases: git runs the hook only for commits it creates through "git commit" (a merge commit, a conflict
# resolved by hand); a rebase replays commits that already raised the version. CI checks every push to main.
[ -n "$SKIP_VERSION_BUMP" ] && exit 0

csproj=src/Optimizer.App/Optimizer.App.csproj
current=$(sed -n 's|.*<Version>\([0-9]*\.[0-9]*\.[0-9]*\)</Version>.*|\1|p' "$csproj" | head -n 1)
if [ -z "$current" ]; then
    echo "pre-commit: no <Version>x.y.z</Version> in $csproj" >&2
    exit 1
fi

version_of() { sed -n 's|.*<Version>\([0-9]*\.[0-9]*\.[0-9]*\)</Version>.*|\1|p' | head -n 1; }

if git diff --cached -U0 -- "$csproj" | grep -q '^+.*<Version>'; then
    # A version set in this commit must still be above the last commit's (a lower one comes back from a merge or a
    # partial commit that staged an old csproj).
    staged=$(git show ":$csproj" | version_of)
    head=$(git show "HEAD:$csproj" 2>/dev/null | version_of)
    if [ -n "$head" ] && [ "$staged" != "$head" ] && [ "$(printf '%s\n%s\n' "$head" "$staged" | sort -V | tail -n 1)" = "$staged" ]; then
        exit 0
    fi
    if [ -z "$head" ]; then exit 0; fi
    echo "pre-commit: the staged version $staged is not above $head. Raise it or unstage the csproj." >&2
    exit 1
fi

# The hook stages the csproj: unstaged edits in it would end up in this commit without being chosen.
if ! git diff --quiet -- "$csproj"; then
    echo "pre-commit: $csproj has unstaged changes. Stage or stash them first." >&2
    exit 1
fi

major=${current%%.*}
rest=${current#*.}
minor=${rest%%.*}
patch=${rest#*.}
next="$major.$minor.$((patch + 1))"

sed -i "s|<Version>$current</Version>|<Version>$next</Version>|" "$csproj"
git add "$csproj"
echo "pre-commit: version $current -> $next"
