<?xml version="1.0" encoding="utf-8"?>
<!--
  Artifact configuration of the SignPath project "Tunero" (paste it into SignPath: Project > Artifact configurations).
  The release workflow uploads the published exe as a GitHub artifact (a zip with Tunero.exe at its root) and passes
  the release version without the "v" as the parameter "version". SignPath signs only an exe whose version resource
  names this product and exactly this version (SignPath Foundation requires both to be enforced).
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="Tunero.exe" product-name="Tunero" product-version="${version}" file-version="${version}.0">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
