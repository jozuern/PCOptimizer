<Project>
  <PropertyGroup>
    <!-- Pinned: "latest" changes with the SDK feature band. -->
    <LangVersion>14</LangVersion>
    <!-- A package with a known moderate, high or critical vulnerability fails the build (NuGet audit). -->
    <WarningsAsErrors>$(WarningsAsErrors);NU1902;NU1903;NU1904</WarningsAsErrors>
    <!-- Embed symbols so the single-file publish produces exactly one file. -->
    <DebugType Condition="'$(Configuration)' == 'Release'">embedded</DebugType>
    <!-- packages.lock.json pins every package and its hash; CI restores with locked mode. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- CI builds: deterministic, and source paths in the embedded symbols do not reveal the build machine's folders. -->
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- Every restore in CI uses the lock files, also the one dotnet publish runs by itself (the publish profile turns
         off the single-file analyzer, which would add an SDK-versioned package the lock file does not hold). -->
    <RestoreLockedMode Condition="'$(GITHUB_ACTIONS)' == 'true' and '$(OS)' == 'Windows_NT'">true</RestoreLockedMode>
    <!-- GitHub's automatic dependency submission restores on Linux, which refuses a Windows target without this. The app
         is only built on Windows. -->
    <EnableWindowsTargeting Condition="'$(OS)' != 'Windows_NT'">true</EnableWindowsTargeting>
    <!-- There the packages the Windows Desktop runtime already contains (System.CodeDom, System.Security.AccessControl)
         are not pruned, so the committed lock files cannot hold the graph (NU1102). That restore only feeds the
         dependency graph: it writes its own lock file under obj and never uses or changes the committed ones. -->
    <NuGetLockFilePath Condition="'$(OS)' != 'Windows_NT'">$(MSBuildProjectDirectory)/obj/linux.packages.lock.json</NuGetLockFilePath>
  </PropertyGroup>
</Project>
